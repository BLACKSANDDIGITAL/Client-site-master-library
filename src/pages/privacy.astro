---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import site from "../content/site.json";
---

<BaseLayout
  title={`Privacy Policy | ${site.businessName}`}
  description={`Privacy policy for ${site.businessName}.`}
>
  <Header />

  <main>
    <section class="section">
      <div class="container">
        <div class="row justify-content-center">
          <article class="col-lg-8">
            <p class="text-uppercase text-accent fw-bold small mb-3">
              Legal
            </p>

            <h1 class="display-5 mb-4">Privacy Policy</h1>

            <p class="text-secondary">
              This is a starter privacy-policy placeholder. Replace it with a
              policy appropriate to the business, location, services, analytics,
              cookies, forms, email marketing, and third-party tools actually used.
            </p>

            <h2 class="h3 mt-5">Information you provide</h2>

            <p class="text-secondary">
              If you contact {site.businessName}, the business may receive the
              information you provide, such as your name, contact details, and
              request details, in order to respond to you.
            </p>

            <h2 class="h3 mt-5">Contact</h2>

            <p class="text-secondary">
              For questions about this policy, contact
              <a href={`mailto:${site.email}`}>{site.email}</a>.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
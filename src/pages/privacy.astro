---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import site from "../content/site.json";
---

<BaseLayout
  title={`Privacy Policy | ${site.businessName}`}
  description={`Privacy information for ${site.businessName}.`}
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="content-container">
        <p class="eyebrow">Privacy</p>
        <h1>Privacy policy</h1>
        <p>
          This page explains how {site.businessName} handles information submitted
          through this website.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="content-container prose">
        <p class="notice">
          This is a starter policy for the master library. Replace it with a
          client-approved policy that accurately reflects the real forms, cookies,
          analytics, booking tools, CRM, payment tools, and data handling in use.
        </p>

        <h2>Information you provide</h2>
        <p>
          The business may receive information you submit through contact, quote,
          booking, or newsletter forms, including information such as your name,
          contact details, service interest, and message.
        </p>

        <h2>How information is used</h2>
        <p>
          Information may be used to respond to your request, provide requested
          services, communicate about appointments, improve the website, and meet
          applicable business or legal requirements.
        </p>

        <h2>Third-party services</h2>
        <p>
          This website may use third-party providers for forms, scheduling, analytics,
          payments, maps, or embedded content. The client must list the actual providers
          and review their privacy practices before launch.
        </p>

        <h2>Contact</h2>
        <p>
          For privacy questions, contact
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8);
    background: var(--color-secondary);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: 0.84rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .page-hero p:last-child,
  .prose p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .prose h2 {
    margin-top: var(--space-7);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }

  .notice {
    padding: var(--space-4);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface-alt);
  }

  .prose a {
    color: var(--color-primary);
    font-weight: 800;
  }
</style>

---
import "../styles/global.css";
import "../styles/library.css";

import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Logo from "../components/ui/Logo.astro";
import PhoneCTA from "../components/ui/PhoneCTA.astro";
import ResponsiveImage from "../components/ui/ResponsiveImage.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ServiceAreaCTA from "../components/ui/ServiceAreaCTA.astro";
import BeforeAfter from "../components/ui/BeforeAfter.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";

import Header from "../components/layout/Header.astro";
import HeaderSimple from "../components/layout/HeaderSimple.astro";
import Footer from "../components/layout/Footer.astro";
import FooterSimple from "../components/layout/FooterSimple.astro";
import AnnouncementBar from "../components/layout/AnnouncementBar.astro";
import MobileCTA from "../components/layout/MobileCTA.astro";

import HeroSplit from "../components/heroes/HeroSplit.astro";
import HeroCentered from "../components/heroes/HeroCentered.astro";
import HeroOverlay from "../components/heroes/HeroOverlay.astro";
import ServiceHero from "../components/heroes/ServiceHero.astro";

import Hero from "../components/sections/Hero.astro";
import ServicesGrid from "../components/sections/ServicesGrid.astro";
import ServiceOverview from "../components/sections/ServiceOverview.astro";
import BenefitsGrid from "../components/sections/BenefitsGrid.astro";
import IncludedList from "../components/sections/IncludedList.astro";
import ServiceComparison from "../components/sections/ServiceComparison.astro";
import RelatedServices from "../components/sections/RelatedServices.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import FeaturedTestimonial from "../components/sections/FeaturedTestimonial.astro";
import FAQ from "../components/sections/FAQ.astro";
import ImageText from "../components/sections/ImageText.astro";
import GalleryGrid from "../components/sections/GalleryGrid.astro";
import TeamGrid from "../components/sections/TeamGrid.astro";
import ProjectHighlight from "../components/sections/ProjectHighlight.astro";
import PricingCards from "../components/sections/PricingCards.astro";
import LogoBar from "../components/sections/LogoBar.astro";
import ServiceArea from "../components/sections/ServiceArea.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";
import EmergencyCTA from "../components/sections/EmergencyCTA.astro";
import IndustryExamples from "../components/sections/IndustryExamples.astro";

import ContactForm from "../components/forms/ContactForm.astro";
import CloudflareContactForm from "../components/forms/CloudflareContactForm.astro";
import TallyForm from "../components/forms/TallyForm.astro";
import ConsentCheckbox from "../components/forms/ConsentCheckbox.astro";
import FormStatus from "../components/forms/FormStatus.astro";
import ComponentShowcase from "../components/library/ComponentShowcase.astro";

const mobileNavItems = [
  { number: "00", label: "Overview", href: "#overview" },
  { number: "01", label: "How to use", href: "#how-to-use" },
  { number: "10", label: "Foundations", href: "#foundations" },
  { number: "11", label: "UI", href: "#ui" },
  { number: "12", label: "Layout", href: "#layout" },
  { number: "13", label: "Forms", href: "#forms" },
  { number: "20", label: "Heroes", href: "#heroes" },
  { number: "21", label: "Services", href: "#services" },
  { number: "22", label: "Trust", href: "#trust" },
  { number: "23", label: "Content", href: "#content" },
  { number: "24", label: "Testimonials", href: "#testimonials" },
  { number: "25", label: "FAQs", href: "#faqs" },
  { number: "26", label: "CTAs", href: "#ctas" },
  { number: "40", label: "Examples", href: "#examples" },
  { number: "80", label: "SEO", href: "#seo" },
  { number: "90", label: "Build process", href: "#build-process" }
];

const colors = [
  { name: "Primary", token: "--color-primary", value: "#0f4c5c" },
  { name: "Primary dark", token: "--color-primary-dark", value: "#083642" },
  { name: "Accent", token: "--color-accent", value: "#f4a261" },
  { name: "Surface alt", token: "--color-surface-alt", value: "#f7fafc" }
];

const seoComponents = [
  {
    file: "SEOHead.astro",
    purpose: "Creates page title, description, canonical URL, and social-sharing metadata.",
    location: "Used by BaseLayout.astro"
  },
  {
    file: "Analytics.astro",
    purpose: "Loads approved analytics only when a valid client-owned tracking ID exists.",
    location: "Base layout after client approval"
  },
  {
    file: "LocalBusinessSchema.astro",
    purpose: "Outputs local-business structured data from verified business information.",
    location: "Base layout for physical/local businesses"
  },
  {
    file: "OrganizationSchema.astro",
    purpose: "Outputs organization structured data when LocalBusiness is not appropriate.",
    location: "Base layout for general organizations"
  },
  {
    file: "ServiceSchema.astro",
    purpose: "Outputs structured data for an individual service detail page.",
    location: "src/pages/services/[slug].astro"
  },
  {
    file: "BreadcrumbSchema.astro",
    purpose: "Outputs breadcrumbs matching visible page breadcrumbs.",
    location: "Individual page with visible breadcrumb navigation"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Internal visual component library and website production system."
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>Client Library | Master Template</title>
  </head>

  <body>
    <div class="library-page">
      <aside class="library-sidebar">
        <a class="library-brand" href="#overview">
          <span class="library-brand-mark">CL</span>

          <span class="library-brand-copy">
            <span class="library-brand-title">Client Library</span>
            <span class="library-brand-subtitle">Master template</span>
          </span>
        </a>

        <div class="library-nav-group">
          <p class="library-nav-label">Start here</p>

          <nav class="library-nav" aria-label="Start here navigation">
            <a href="#overview">
              <span class="library-nav-number">00</span>
              <span>Overview</span>
            </a>

            <a href="#how-to-use">
              <span class="library-nav-number">01</span>
              <span>How to use</span>
            </a>

            <a href="#build-process">
              <span class="library-nav-number">90</span>
              <span>Build process</span>
            </a>
          </nav>
        </div>

        <div class="library-nav-group">
          <p class="library-nav-label">Foundations</p>

          <nav class="library-nav" aria-label="Foundations navigation">
            <a href="#foundations">
              <span class="library-nav-number">10</span>
              <span>Brand tokens</span>
            </a>

            <a href="#ui">
              <span class="library-nav-number">11</span>
              <span>UI components</span>
            </a>

            <a href="#layout">
              <span class="library-nav-number">12</span>
              <span>Layouts</span>
            </a>

            <a href="#forms">
              <span class="library-nav-number">13</span>
              <span>Forms</span>
            </a>
          </nav>
        </div>

        <div class="library-nav-group">
          <p class="library-nav-label">Website sections</p>

          <nav class="library-nav" aria-label="Website component navigation">
            <a href="#heroes">
              <span class="library-nav-number">20</span>
              <span>Heroes</span>
            </a>

            <a href="#services">
              <span class="library-nav-number">21</span>
              <span>Services</span>
            </a>

            <a href="#trust">
              <span class="library-nav-number">22</span>
              <span>Trust and process</span>
            </a>

            <a href="#content">
              <span class="library-nav-number">23</span>
              <span>Content and media</span>
            </a>

            <a href="#testimonials">
              <span class="library-nav-number">24</span>
              <span>Testimonials</span>
            </a>

            <a href="#faqs">
              <span class="library-nav-number">25</span>
              <span>FAQs</span>
            </a>

            <a href="#ctas">
              <span class="library-nav-number">26</span>
              <span>Calls to action</span>
            </a>
          </nav>
        </div>

        <div class="library-nav-group">
          <p class="library-nav-label">Full examples</p>

          <nav class="library-nav" aria-label="Industry example navigation">
            <a href="#examples">
              <span class="library-nav-number">40</span>
              <span>Industry gallery</span>
            </a>

            <a href="/examples/home-service">
              <span class="library-nav-number">41</span>
              <span>Home services</span>
            </a>

            <a href="/examples/professional-service">
              <span class="library-nav-number">42</span>
              <span>Professional services</span>
            </a>
          </nav>
        </div>

        <div class="library-nav-group">
          <p class="library-nav-label">Delivery</p>

          <nav class="library-nav" aria-label="Delivery navigation">
            <a href="#seo">
              <span class="library-nav-number">80</span>
              <span>SEO and schema</span>
            </a>

            <a href="/blueprints">
              <span class="library-nav-number">85</span>
              <span>Blueprints</span>
            </a>

            <a href="#build-process">
              <span class="library-nav-number">90</span>
              <span>QA and launch</span>
            </a>
          </nav>
        </div>

        <div class="library-sidebar-footer">
          <p>Internal website production system.</p>
          <p><a href="#build-process">Review the client build process.</a></p>
        </div>
      </aside>

      <div class="library-main">
        <header class="library-topbar">
          <p class="library-topbar-title">Client website system</p>
          <span class="library-topbar-status">Internal reference</span>
        </header>

        <main>
          <section id="overview" class="library-intro">
            <div class="library-intro-inner">
              <p class="library-kicker">Astro master library</p>

              <h1>Reusable website components, page recipes, and industry examples.</h1>

              <p class="library-intro-description">
                Use this internal reference to choose a client-appropriate website
                structure, preview the real component variations, identify the data
                source for each section, and build a complete client site consistently.
              </p>

              <div class="library-intro-actions">
                <a class="library-quick-link" href="#how-to-use">How to use this library</a>
                <a class="library-quick-link" href="#examples">Browse examples</a>
                <a class="library-quick-link" href="#build-process">View build process</a>
              </div>

              <div class="library-mobile-contents">
                <strong>Jump to a section</strong>

                <nav aria-label="Mobile component library navigation">
                  {mobileNavItems.map((item) => (
                    <a href={item.href}>{item.number} {item.label}</a>
                  ))}
                </nav>
              </div>
            </div>
          </section>
          <div class="library-content">
          <section id="system-model" class="library-section">
  <div class="library-section-heading">
    <div>
      <p class="library-section-number">00 — System model</p>
      <h2>How the master website system works</h2>
    </div>

    <p class="library-component-file">
      Guide: <code>README.md</code>
    </p>
  </div>

  <div class="library-preview library-preview--white">
    <div class="system-model-grid">
      <article>
        <span>01</span>
        <h3>Components</h3>
        <p>Reusable layouts and interface sections.</p>
        <code>src/components/</code>
      </article>

      <article>
        <span>02</span>
        <h3>JSON content</h3>
        <p>Client business details and factual structured content.</p>
        <code>src/content/</code>
      </article>

      <article>
        <span>03</span>
        <h3>Page files</h3>
        <p>Finished page recipes assembled from components.</p>
        <code>src/pages/</code>
      </article>

      <article>
        <span>04</span>
        <h3>Theme tokens</h3>
        <p>Brand colors, fonts, spacing, shape, and shared styling.</p>
        <code>src/styles/theme.css</code>
      </article>

      <article>
        <span>05</span>
        <h3>Documents</h3>
        <p>Intake, QA, handoff, maintenance, and launch process.</p>
        <code>docs/</code>
      </article>
    </div>
  </div>

  <div class="library-docs">
    <div>
      <h3>Build sequence</h3>
      <p>
        Update verified client content and brand tokens first. Select components
        from the visual gallery second. Assemble pages from those components last.
      </p>
    </div>

    <aside class="library-note library-note--success">
      <strong>Why it works:</strong> content stays centralized, styling stays
      consistent, and proven page sections can be reused without copying an old
      client website.
    </aside>
  </div>
</section>
            <section id="how-to-use" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">01 — How to use</p>
                  <h2>Start with the business goal, not the component list</h2>
                </div>

                <p class="library-component-file">
                  Guide: <code>docs/new-client-setup.md</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <ol class="library-checklist">
                  <li>Choose the closest industry example and identify the client’s conversion goal.</li>
                  <li>Update verified business facts in <code>src/content/site.json</code>.</li>
                  <li>Set colors, fonts, spacing, and visual style in <code>src/styles/theme.css</code>.</li>
                  <li>Choose a header, hero, service section, proof pattern, FAQ, and conversion CTA.</li>
                  <li>Replace all placeholder copy, images, testimonials, pricing, ratings, and claims.</li>
                  <li>Connect and test every form, booking, map, payment, social, and phone link.</li>
                  <li>Run <code>npm run build</code> before a preview or production deployment.</li>
                </ol>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Core rule</h3>
                  <p>
                    This library is a toolbox. Select only the parts that help a visitor
                    understand the client’s offer, trust the business, and take a useful
                    next step.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Content first:</strong> update normal business information in
                  <code> src/content/</code>. Update a component only when you are making
                  a generic, reusable system improvement.
                </aside>
              </div>
            </section>

            <section id="foundations" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">10 — Foundations</p>
                  <h2>Theme tokens and reusable style decisions</h2>
                </div>

                <p class="library-component-file">
                  File: <code>src/styles/theme.css</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="library-token-grid">
                  {colors.map((color) => (
                    <article class="library-token-card">
                      <div
                        class="library-token-swatch"
                        style={`background: ${color.value};`}
                        aria-label={`${color.name} color swatch`}
                      ></div>

                      <h3>{color.name}</h3>
                      <code>{color.token}</code>
                    </article>
                  ))}
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Use tokens before one-off CSS</h3>
                  <p>
                    Client brand changes belong in <code>theme.css</code>. One token
                    update should influence buttons, cards, headers, footers, forms,
                    section backgrounds, and CTA patterns consistently.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Keep the system stable:</strong> change token values, not
                  shared token names, unless you are intentionally changing the master
                  component library.
                </aside>
              </div>
            </section>

            <section id="ui" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">11 — UI</p>
                  <h2>Small components that keep each site consistent</h2>
                </div>

                <p class="library-component-file">
                  Folder: <code>src/components/ui/</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <SectionHeading
                  eyebrow="Button and UI system"
                  title="Actions should be obvious and specific"
                  description="Use labels that tell visitors exactly what happens next."
                />

                <div class="library-demo-row">
                  <Button href="/contact">Primary action</Button>
                  <Button href="/contact" variant="secondary">Secondary action</Button>
                  <Button href="/contact" variant="outline">Outline action</Button>
                  <Button href="/contact" variant="text">Text action</Button>
                  <PhoneCTA />
                  <ServiceAreaCTA />
                </div>

                <div class="library-mini-grid">
                  <Card>
                    <h3>Reusable Card</h3>
                    <p>
                      Use for service summaries, project previews, pricing, reviews,
                      proof, and small grouped content.
                    </p>
                  </Card>

                  <Card>
                    <Logo />
                    <p>
                      Use the Logo component in headers and footers so the business
                      name and mark stay consistent.
                    </p>
                  </Card>

                  <Card>
                    <Breadcrumbs
                      items={[
                        { label: "Home", href: "/" },
                        { label: "Services", href: "/services" },
                        { label: "Example service" }
                      ]}
                    />
                    <p>Use breadcrumbs on deep service, location, project, and article pages.</p>
                  </Card>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Files included</h3>

                  <ul>
                    <li><code>Button.astro</code> for consistent action styles.</li>
                    <li><code>Card.astro</code> for grouped content.</li>
                    <li><code>Logo.astro</code> for a shared business identity.</li>
                    <li><code>PhoneCTA.astro</code> and <code>ServiceAreaCTA.astro</code> for local conversion paths.</li>
                    <li><code>Breadcrumbs.astro</code> for page hierarchy.</li>
                    <li><code>ResponsiveImage.astro</code> for standard responsive image markup.</li>
                  </ul>
                </div>

                <aside class="library-note library-note--warning">
                  <strong>Do not overload pages:</strong> use a single clear primary
                  action per visual area. Avoid displaying several competing buttons,
                  cards, or attention-grabbing elements at once.
                </aside>
              </div>
            </section>

            <section id="layout" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">12 — Layout</p>
                  <h2>Headers, footers, announcements, and mobile conversion</h2>
                </div>

                <p class="library-component-file">
                  Folder: <code>src/components/layout/</code>
                </p>
              </div>

              <div class="library-preview library-preview--white library-layout-preview">
                <p class="library-preview-label">Announcement Bar</p>
                <AnnouncementBar />

                <p class="library-preview-label">Primary Header</p>
                <Header />

                <p class="library-preview-label">Simple Header</p>
                <HeaderSimple />

                <p class="library-preview-label">Expanded Footer</p>
                <Footer />

                <p class="library-preview-label">Simple Footer</p>
                <FooterSimple />
              </div>

              <div class="library-docs">
                <div>
                  <h3>Choose one page shell</h3>

                  <ul>
                    <li><code>Header.astro</code> is the default full client header.</li>
                    <li><code>HeaderSimple.astro</code> is for lean sites, portfolios, and minimal layouts.</li>
                    <li><code>Footer.astro</code> is the full local-business footer with contact and legal links.</li>
                    <li><code>FooterSimple.astro</code> is suitable for a lighter site footer.</li>
                    <li><code>AnnouncementBar.astro</code> is for a real temporary message, offer, closure, or verified service notice.</li>
                    <li><code>MobileCTA.astro</code> is designed for mobile-only call or lead actions.</li>
                  </ul>
                </div>

                <aside class="library-note">
                  <strong>Mobile CTA note:</strong> the sticky mobile CTA is intentionally
                  hidden at desktop widths. Resize the browser below 700px to test it.
                  Add it to phone-first service sites only after confirming it does not
                  cover content or conflict with cookie/form controls.
                </aside>
              </div>
            </section>

            <section id="forms" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">13 — Forms</p>
                  <h2>Lead-capture patterns and provider options</h2>
                </div>

                <p class="library-component-file">
                  Folder: <code>src/components/forms/</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="library-form-grid">
                  <ContactForm />
                  <CloudflareContactForm />
                </div>

                <div class="library-form-wide">
                  <TallyForm />
                </div>

                <div class="library-mini-grid">
                  <Card>
                    <h3>Consent checkbox</h3>
                    <ConsentCheckbox />
                  </Card>

                  <Card>
                    <h3>Info state</h3>
                    <FormStatus type="info">
                      Connect a real form endpoint before production launch.
                    </FormStatus>
                  </Card>

                  <Card>
                    <h3>Success state</h3>
                    <FormStatus type="success">
                      Example: Your request has been received.
                    </FormStatus>
                  </Card>
                </div>

                <div class="library-form-statuses">
                  <FormStatus type="error">
                    Error example: Enter a valid email address before submitting.
                  </FormStatus>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Form selection guide</h3>

                  <ul>
                    <li><code>ContactForm.astro</code>: general service leads and inquiries.</li>
                    <li><code>CloudflareContactForm.astro</code>: use when the client project is configured to process a Cloudflare-based form workflow.</li>
                    <li><code>TallyForm.astro</code>: fast embedded intake, quote, or discovery form option.</li>
                    <li><code>ConsentCheckbox.astro</code>: use only when appropriate for the client’s data-use and marketing requirements.</li>
                    <li><code>Honeypot.astro</code>: basic spam-reduction field used inside a form.</li>
                    <li><code>FormStatus.astro</code>: accessible message styling for info, success, and error feedback.</li>
                  </ul>
                </div>

                <aside class="library-note library-note--warning">
                  <strong>Required before launch:</strong> test a live production
                  submission and confirm it arrives at the intended inbox, CRM, or
                  provider dashboard. Never assume a visual form sends email.
                </aside>
              </div>
            </section>

            <ComponentShowcase
  id="hero-split"
  number="20.01"
  category="Hero"
  title="Split Hero"
  file="src/components/heroes/HeroSplit.astro"
  bestFor="Default homepage layout for local services, consultants, agencies, and portfolios. Works when a message and visual proof both matter."
  dataSource="Props: eyebrow, title, description, CTAs. Optional approved client image."
  status="ready"
>
  <HeroSplit />

  <Fragment slot="notes">
    <p>
      <strong>Use it when:</strong> the client has a clear service message and a
      high-quality team, service, product, or project image.
    </p>
  </Fragment>
</ComponentShowcase>

<ComponentShowcase
  id="hero-centered"
  number="20.02"
  category="Hero"
  title="Centered Conversion Hero"
  file="src/components/heroes/HeroCentered.astro"
  bestFor="Consultants, wellness providers, professional services, simple campaigns, and pages with one primary conversion."
  dataSource="Props: eyebrow, title, description, primary CTA, optional secondary CTA."
  status="ready"
>
  <HeroCentered />

  <Fragment slot="notes">
    <p>
      <strong>Use it when:</strong> the headline is more important than a large
      photo and you want a calm, focused opening.
    </p>
  </Fragment>
</ComponentShowcase>

<ComponentShowcase
  id="hero-overlay"
  number="20.03"
  category="Hero"
  title="Image Overlay Hero"
  file="src/components/heroes/HeroOverlay.astro"
  bestFor="Restaurants, landscaping, salons, hospitality, photography, venues, and businesses with compelling approved photography."
  dataSource="Props: image URL, alt context, headline, description, CTA."
  status="ready"
  fullBleed={true}
>
  <HeroOverlay />

  <Fragment slot="notes">
    <p>
      <strong>Before launch:</strong> replace the placeholder with a permitted,
      high-resolution image. Ensure the overlay keeps text readable.
    </p>
  </Fragment>
</ComponentShowcase>

<ComponentShowcase
  id="hero-service"
  number="20.04"
  category="Hero"
  title="Service Detail Hero"
  file="src/components/heroes/ServiceHero.astro"
  bestFor="Individual service pages, detailed landing pages, and service-area pages with genuinely distinct information."
  dataSource="Service name, description, optional location, and breadcrumb data."
  status="ready"
>
  <ServiceHero
    serviceName="Example Service"
    description="Use a focused service page intro to explain the customer need, the service approach, and how to request help."
    location="Your Local Service Area"
  />

  <Fragment slot="notes">
    <p>
      <strong>Page rule:</strong> match it with visible breadcrumbs, relevant
      service details, FAQ, and one clear contact or estimate CTA.
    </p>
  </Fragment>
</ComponentShowcase>

            <section id="services" class="library-section">

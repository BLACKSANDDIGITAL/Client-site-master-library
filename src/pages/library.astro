                  <h2>Show proof and clarify what happens next</h2>
                </div>

                <p class="library-component-file">
                  Files: <code>TrustBar.astro</code>, <code>WhyChooseUs.astro</code>, and <code>ProcessSteps.astro</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="library-variant-stack">
                  <TrustBar
                    items={[
                      { value: "Local", label: "Use accurate area information" },
                      { value: "Licensed", label: "Only if verified" },
                      { value: "Insured", label: "Only if verified" },
                      { value: "Experienced", label: "Use real approved proof" }
                    ]}
                  />

                  <WhyChooseUs />

                  <ProcessSteps
                    title="A simple client process"
                    description="Use actual steps so visitors know what happens after they call, submit a request, or book."
                  />
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Placement guide</h3>

                  <ul>
                    <li>TrustBar: under the hero or directly above the main services block.</li>
                    <li>WhyChooseUs: after service discovery, when visitors need a reason to choose this business.</li>
                    <li>ProcessSteps: before testimonials, FAQ, or the final CTA.</li>
                  </ul>
                </div>

                <aside class="library-note library-note--warning">
                  <strong>Proof must be real:</strong> never publish placeholder
                  licenses, insurance, certifications, awards, review scores, guarantee
                  terms, response times, or experience claims.
                </aside>
              </div>
            </section>


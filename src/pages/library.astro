---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import HeroSplit from "../components/heroes/HeroSplit.astro";
import ServicesGrid from "../components/sections/ServicesGrid.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import FAQ from "../components/sections/FAQ.astro";

import services from "../content/services.json";
import testimonials from "../content/testimonials.json";
import faq from "../content/faq.json";
---

<BaseLayout
  title="Component Library | Demo Local Business"
  description="Internal preview of reusable website components."
>
  <Header />

  <main>
    <section class="py-5 bg-dark text-white">
      <div class="container">
        <p class="text-uppercase text-warning fw-bold small mb-3">
          Internal Design System
        </p>

        <h1 class="display-4 mb-3">
          Client Website Component Library
        </h1>

        <p class="lead text-white-50 mb-0">
          Preview reusable sections here before choosing a page layout for a client.
        </p>
      </div>
    </section>

    <section class="py-4 border-bottom bg-white sticky-top">
      <div class="container">
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-outline-dark btn-sm" href="#heroes">Heroes</a>
          <a class="btn btn-outline-dark btn-sm" href="#services">Services</a>
          <a class="btn btn-outline-dark btn-sm" href="#testimonials">Testimonials</a>
          <a class="btn btn-outline-dark btn-sm" href="#faq">FAQ</a>
          <a class="btn btn-outline-dark btn-sm" href="#cta">CTA</a>
        </div>
      </div>
    </section>

    <section id="heroes" class="border-bottom">
      <div class="container py-4">
        <p class="text-uppercase text-accent fw-bold small mb-2">
          Hero option 1
        </p>

        <h2 class="h3 mb-0">Split Hero</h2>
      </div>

      <HeroSplit
        eyebrow="Hero Option One"
        title="A reusable split-layout hero section."
        description="Use this for service businesses, consultants, agencies, portfolios, and many other client websites."
        primaryCtaLabel="Primary Call to Action"
        primaryCtaHref="#cta"
        secondaryCtaLabel="Secondary Action"
        secondaryCtaHref="#services"
      />
    </section>

    <section id="services" class="border-bottom">
      <div class="container py-4">
        <p class="text-uppercase text-accent fw-bold small mb-2">
          Service option 1
        </p>

        <h2 class="h3 mb-0">Three-Card Services Grid</h2>
      </div>

      <ServicesGrid services={services} />
    </section>

    <section id="testimonials" class="border-bottom">
      <div class="container py-4">
        <p class="text-uppercase text-accent fw-bold small mb-2">
          Social proof option 1
        </p>

        <h2 class="h3 mb-0">Testimonial Cards</h2>
      </div>

      <Testimonials testimonials={testimonials} />
    </section>

    <section id="faq" class="border-bottom">
      <div class="container py-4">
        <p class="text-uppercase text-accent fw-bold small mb-2">
          FAQ option 1
        </p>

        <h2 class="h3 mb-0">Bootstrap Accordion</h2>
      </div>

      <FAQ items={faq} />
    </section>

    <section id="cta" class="section bg-dark text-white">
      <div class="container text-center">
        <p class="text-uppercase text-warning fw-bold small mb-3">
          CTA option 1
        </p>

        <h2 class="display-6 mb-4">
          A simple, high-contrast final call to action.
        </h2>

        <p class="lead text-white-50 mb-4">
          Use this near the bottom of a page to move visitors toward calling,
          booking, requesting an estimate, or starting a conversation.
        </p>

        <a class="btn btn-light btn-lg" href="/contact">
          Request an Estimate
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
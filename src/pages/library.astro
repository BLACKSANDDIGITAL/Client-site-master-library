                  />

                  <TeamGrid />

                  <ProjectHighlight />

                  <BeforeAfter />

                  <LogoBar />

                  <PricingCards />

                  <ServiceArea />
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Choose by industry</h3>

                  <ul>
                    <li>Landscaping, construction, cleaning, design, restaurants, beauty: prioritize GalleryGrid and BeforeAfter where authentic images exist.</li>
                    <li>Consultants, clinics, salons, law firms, agencies: use TeamGrid and ImageText to introduce people and expertise.</li>
                    <li>Agencies, contractors, design studios: use ProjectHighlight for a concise real project story.</li>
                    <li>Package-based services: use PricingCards only for current, approved pricing or transparent “contact for pricing” packages.</li>
                    <li>Local businesses: use ServiceArea with actual coverage information.</li>
                  </ul>
                </div>

                <aside class="library-note">
                  <strong>Image rights:</strong> only use assets the client owns,
                  licenses, or has permission to publish. Informative images need useful
                  alt text; decorative images should use <code>alt=""</code>.
                </aside>
              </div>
            </section>

            <section id="testimonials" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">24 — Testimonials</p>
                  <h2>Use customer proof carefully and transparently</h2>
                </div>

                <p class="library-component-file">
                  Files: <code>Testimonials.astro</code> and <code>FeaturedTestimonial.astro</code>
                </p>
              </div>

              <div class="library-preview">

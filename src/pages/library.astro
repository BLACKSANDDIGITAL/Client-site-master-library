              <div class="library-preview">
                <div class="library-variant-stack">
                  <ImageText
                    eyebrow="About the business"
                    title="Image and text section"
                    description="Use for an owner message, service explanation, company story, location detail, or important differentiator."
                    buttonLabel="Contact us"

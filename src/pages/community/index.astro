---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ContactCTA from "../../components/sections/ContactCTA.astro";
import site from "../../content/site.json";
import community from "../../content/community.json";
---

<BaseLayout
  title={`Community | ${site.businessName}`}
  description={`Get involved with ${site.businessName}.`}
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Community</p>
        <h1>Get involved</h1>
        <p>Discover opportunities to participate, volunteer, and connect.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        {community.length > 0 ? (
          <div class="community-grid">
            {community.map((item) => (
              <article class="community-card">
                <span class="type-badge">{item.type}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                {item.date && <p class="meta">Date: {item.date}</p>}
                {item.location && <p class="meta">Location: {item.location}</p>}
                <a href={`/community/${item.slug}`}>Learn more</a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-state">Add community opportunities in <code>src/content/community.json</code>.</p>
        )}
      </div>
    </section>

    <ContactCTA />
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero { padding-block: var(--space-8); background: var(--color-secondary); }
  .page-hero > div { max-width: 780px; }
  .eyebrow { margin: 0 0 var(--space-3); color: var(--color-primary); font-size: 0.9rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.05; }
  .community-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .community-card { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); }
  .type-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); background: var(--color-accent); color: var(--color-text); font-size: 0.75rem; font-weight: 700; }
  .community-card h3 { margin-top: var(--space-2); font-size: 1.3rem; }
  .community-card p { color: var(--color-muted); }
  .meta { font-size: 0.9rem; }
  a { color: var(--color-primary); font-weight: 700; }
  .empty-state { grid-column: 1 / -1; padding: var(--space-5); border: 1px dashed var(--color-border); border-radius: var(--radius-md); }
  @media (max-width: 860px) { .community-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .community-grid { grid-template-columns: 1fr; } }
</style>

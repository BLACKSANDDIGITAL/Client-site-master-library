---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
---

<BaseLayout
  title="Industry Example | Client Library"
  description="Internal industry template placeholder."
  noindex={true}
>
  <Header />

  <main>
    <section class="template-placeholder">
      <div class="content-container">
        <p>Industry example</p>
        <h1>Template in progress</h1>
        <p>
          This route is reserved for a full industry example. Build it by combining
          the reusable components listed on the Component Library page.
        </p>
        <a href="/library">Return to the component library</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .template-placeholder {
    min-height: 65vh;
    padding-block: var(--space-9);
    background: var(--color-secondary);
  }

  .template-placeholder p:first-child {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  p:not(:first-child) {
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  a {
    color: var(--color-primary);
    font-weight: 800;
  }
</style>

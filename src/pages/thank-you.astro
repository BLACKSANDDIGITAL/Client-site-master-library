---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import PhoneCTA from "../components/ui/PhoneCTA.astro";
import site from "../content/site.json";
---

<BaseLayout
  title={`Thank You | ${site.businessName}`}
  description="Thank you for contacting us."
>
  <Header />

  <main>
    <section class="thank-you">
      <div class="content-container">
        <p class="eyebrow">Message received</p>
        <h1>Thank you for getting in touch.</h1>
        <p>
          We have received your request. A team member will follow up as soon as possible.
        </p>
        <p>
          Need immediate help? Call us at <a href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a>.
        </p>
        <PhoneCTA label="Call now" />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .thank-you {
    padding-block: var(--space-9);
    background: linear-gradient(135deg, var(--color-secondary), var(--color-surface));
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  p {
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  a {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>

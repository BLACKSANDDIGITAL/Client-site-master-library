---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

import Button from "../components/ui/Button.astro";
import PhoneCTA from "../components/ui/PhoneCTA.astro";

import ServicesGrid from "../components/sections/ServicesGrid.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import ImageText from "../components/sections/ImageText.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import ServiceArea from "../components/sections/ServiceArea.astro";
import FAQ from "../components/sections/FAQ.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";

import site from "../content/site.json";
---

<BaseLayout
  title={`${site.businessName} | ${site.tagline}`}
  description={site.description}
>
  <Header />

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">Serving {site.serviceAreas[0]} and nearby areas</p>
          <h1>{site.tagline}</h1>
          <p class="hero-description">{site.description}</p>

          <div class="hero-actions">
            <Button href={site.primaryCta.href}>
              {site.primaryCta.label}
            </Button>

            <PhoneCTA />
          </div>
        </div>

        <aside class="hero-card" aria-label="Business contact details">
          <p class="hero-card-label">Get in touch</p>
          <p><strong>{site.phoneDisplay}</strong></p>
          <p>{site.hours}</p>
          <p>Serving {site.serviceAreas.join(", ")}</p>
        </aside>
      </div>
    </section>

    <TrustBar />

    <ServicesGrid
      title="Services built around your needs"
      description="Explore the core services offered by this local business."
    />

    <ImageText
      eyebrow="Why work with us"
      title="Clear service from first contact to final follow-up"
      description="Use this section to present the real, client-approved reasons someone should choose this business."
      ctaLabel="Learn more"
      ctaHref="/about"
    />

    <WhyChooseUs />

    <ProcessSteps />

    <Testimonials />

    <ServiceArea />

    <FAQ />

    <ContactCTA
      title="Let's talk about your project"
      description="Request an estimate or call now to discuss the service you need."
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-9);
    background:
      radial-gradient(circle at top right, rgba(244, 162, 97, 0.26), transparent 35%),
      linear-gradient(135deg, var(--color-secondary), var(--color-surface));
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.7fr);
    align-items: center;
    gap: var(--space-7);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .hero-description {
    max-width: 650px;
    margin: var(--space-5) 0 0;
    color: var(--color-muted);
    font-size: 1.15rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: var(--shadow-md);
  }

  .hero-card-label {
    margin-top: 0;
    color: var(--color-primary);
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero-card p {
    color: var(--color-muted);
  }

  .hero-card strong {
    color: var(--color-text);
    font-size: 1.3rem;
  }

  @media (max-width: 760px) {
    .hero {
      padding-block: var(--space-8);
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>

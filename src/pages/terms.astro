---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import site from "../content/site.json";
---

<BaseLayout
  title={`Terms | ${site.businessName}`}
  description={`Terms of use for ${site.businessName}.`}
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="content-container">
        <p class="eyebrow">Terms</p>
        <h1>Terms of use</h1>
        <p>
          Please review these terms before using this website or contacting
          {site.businessName}.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="content-container prose">
        <p class="notice">
          This is a starter placeholder for the master library. Replace it with
          client-approved terms that accurately reflect the business, its services,
          website functions, booking process, payment process, and applicable policies.
        </p>

        <h2>Website information</h2>
        <p>
          Website information is provided for general informational purposes. The
          business should review all service descriptions, availability statements,
          pricing, promotions, policies, and business claims before publication.
        </p>

        <h2>Contact and service requests</h2>
        <p>
          Submitting a form, requesting an estimate, or contacting the business does
          not create a contract unless the business confirms the arrangement through
          its normal process.
        </p>

        <h2>Updates</h2>
        <p>
          The business may update website content, services, availability, or policies
          when appropriate. Replace this section with the client’s actual terms and
          effective-date details before launch.
        </p>

        <h2>Contact</h2>
        <p>
          Questions may be directed to <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8);
    background: var(--color-secondary);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: 0.84rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .page-hero p:last-child,
  .prose p {
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .prose h2 {
    margin-top: var(--space-7);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }

  .notice {
    padding: var(--space-4);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface-alt);
  }

  .prose a {
    color: var(--color-primary);
    font-weight: 800;
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";
import site from "../content/site.json";
---

<BaseLayout
  title={`About | ${site.businessName}`}
  description={`Learn about ${site.businessName}.`}
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="content-container">
        <p class="eyebrow">About us</p>
        <h1>Local service, clear communication, dependable support</h1>
        <p>
          This is placeholder content for your master library. Replace it with the
          real business story, experience, credentials, values, and team information.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="content-container">
        <h2>Our approach</h2>
        <p>
          Keep this page honest and specific. Use real facts: when the business
          started, who runs it, which areas it serves, how customers are supported,
          and which licenses or certifications can be verified.
        </p>

        <h2>Areas we serve</h2>
        <p>{site.serviceAreas.join(", ")}.</p>
      </div>
    </section>

    <ContactCTA />
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8);
    background: var(--color-secondary);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  h2 {
    margin-top: var(--space-7);
    font-size: clamp(1.8rem, 4vw, 2.75rem);
  }

  p {
    color: var(--color-muted);
    font-size: 1.1rem;
  }
</style>

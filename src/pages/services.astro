---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ServicesGrid from "../components/sections/ServicesGrid.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";
import site from "../content/site.json";
---

<BaseLayout
  title={`Services | ${site.businessName}`}
  description={`Explore services from ${site.businessName}.`}
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">What we do</p>
        <h1>Services designed to help you move forward</h1>
        <p>Review our services, then contact us to discuss what you need.</p>
      </div>
    </section>

    <ServicesGrid
      title="Explore our services"
      description="Choose a service to learn more about what is included and how to get started."
    />

    <ContactCTA />
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8);
    background: var(--color-secondary);
  }

  .page-hero > div {
    max-width: 780px;
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  p:last-child {
    max-width: 680px;
    color: var(--color-muted);
    font-size: 1.1rem;
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import site from "../content/site.json";
import services from "../content/services.json";
---

<BaseLayout
  title={`Services | ${site.businessName}`}
  description={`Explore services from ${site.businessName}.`}
>
  <Header />

  <main>
    <section class="section section-muted">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <p class="text-uppercase text-accent fw-bold small mb-3">
              Our Services
            </p>

            <h1 class="display-4 mb-4">
              Reliable help for your home or business.
            </h1>

            <p class="lead text-secondary mb-0">
              Explore our services, then contact us to discuss what you need.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="row g-4">
          {
            services.map((service) => (
              <div class="col-md-6 col-lg-4">
                <article class="card h-100 p-4">
                  <div class="fs-2 text-primary mb-4">
                    <i class={`bi ${service.icon}`}></i>
                  </div>

                  <h2 class="h3">{service.title}</h2>

                  <p class="text-secondary mb-4">
                    {service.description}
                  </p>

                  <a class="fw-bold text-decoration-none mt-auto" href="/contact">
                    Request an estimate <span aria-hidden="true">→</span>
                  </a>
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section bg-dark text-white">
      <div class="container text-center">
        <h2 class="display-6 mb-4">
          Not sure which service you need?
        </h2>

        <a class="btn btn-light btn-lg" href="/contact">
          Contact Us
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import site from "../content/site.json";
---

<BaseLayout
  title={`Contact | ${site.businessName}`}
  description={`Contact ${site.businessName} to ask a question or request an estimate.`}
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Contact us</p>
        <h1>Tell us how we can help</h1>
        <p>Call, email, or send a message. We will follow up as soon as possible.</p>
      </div>
    </section>

    <section class="section">
      <div class="container contact-grid">
        <div>
          <h2>Contact details</h2>
          <p><strong>Phone:</strong> <a href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a></p>
          <p><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p><strong>Hours:</strong> {site.hours}</p>
          <p><strong>Service area:</strong> {site.serviceAreas.join(", ")}</p>
        </div>

        <form class="contact-form" action="/thank-you" method="get">
          <h2>Request an estimate</h2>

          <label for="name">Name <span aria-hidden="true">*</span></label>
          <input id="name" name="name" type="text" autocomplete="name" required />

          <label for="phone">Phone <span aria-hidden="true">*</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" required />

          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required />

          <label for="service">Service needed</label>
          <select id="service" name="service">
            <option value="">Select a service</option>
            <option value="service-one">Service One</option>
            <option value="service-two">Service Two</option>
            <option value="service-three">Service Three</option>
          </select>

          <label for="message">How can we help? <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="6" required></textarea>

          <button type="submit">Send request</button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8);
    background: var(--color-secondary);
  }

  .page-hero > div {
    max-width: 780px;
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-7);
  }

  .contact-form {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-alt);
  }

  .contact-form h2 {
    margin-top: 0;
  }

  label {
    font-weight: 700;
  }

  input,
  textarea,
  select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: white;
  }

  button {
    min-height: 48px;
    margin-top: var(--space-2);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: white;
    cursor: pointer;
    font-weight: 700;
  }

  button:hover {
    background: var(--color-primary-dark);
  }

  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>

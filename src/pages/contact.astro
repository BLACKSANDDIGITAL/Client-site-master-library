---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import site from "../content/site.json";
import CloudflareContactForm from "../components/forms/CloudflareContactForm.astro";
---

<BaseLayout
  title={`Contact | ${site.businessName}`}
  description={`Contact ${site.businessName} to request service or an estimate.`}
>
  <Header />

  <main>
    <section class="section section-muted">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <p class="text-uppercase text-accent fw-bold small mb-3">
              Contact Us
            </p>

            <h1 class="display-4 mb-4">
              Tell us how we can help.
            </h1>

            <p class="lead text-secondary mb-0">
              Contact us by phone or email, and we will get back to you as soon as possible.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="row g-5 justify-content-center">
          <div class="col-lg-5">
            <h2 class="h3 mb-4">Get in touch</h2>

            <div class="d-flex gap-3 mb-4">
              <i class="bi bi-telephone-fill fs-3 text-primary"></i>
              <div>
                <h3 class="h5 mb-1">Call</h3>
                <a href={`tel:${site.phoneLink}`} class="text-decoration-none">
                  {site.phoneDisplay}
                </a>
              </div>
            </div>

            <div class="d-flex gap-3 mb-4">
              <i class="bi bi-envelope-fill fs-3 text-primary"></i>
              <div>
                <h3 class="h5 mb-1">Email</h3>
                <a href={`mailto:${site.email}`} class="text-decoration-none">
                  {site.email}
                </a>
              </div>
            </div>

            <div class="d-flex gap-3 mb-4">
              <i class="bi bi-clock-fill fs-3 text-primary"></i>
              <div>
                <h3 class="h5 mb-1">Hours</h3>
                <p class="mb-0 text-secondary">{site.hours}</p>
              </div>
            </div>

            <div class="d-flex gap-3">
              <i class="bi bi-geo-alt-fill fs-3 text-primary"></i>
              <div>
                <h3 class="h5 mb-1">Service area</h3>
                <p class="mb-0 text-secondary">
                  {site.serviceAreas.join(", ")}
                </p>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="card p-4 p-md-5">
              <h2 class="h3 mb-3">Request an estimate</h2>

              <p class="text-secondary mb-4">
                Use the button below to start an email with the details of your request.
              </p>

             <div class="col-lg-6">
  <h2 class="h3 mb-4">Request an estimate</h2>

  <CloudflareContactForm />
</div>

              <p class="small text-secondary mt-4 mb-0">
                For a production client site, replace this with a tested form endpoint.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
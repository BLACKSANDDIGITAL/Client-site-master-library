---
import "../styles/library.css";

const guideNav = [
  { number: "01", label: "Start Here", href: "#start-here" },
  { number: "02", label: "Set Up Your Computer", href: "#computer-setup" },
  { number: "03", label: "Understand the Project", href: "#understand-project" },
  { number: "04", label: "Start a New Client Website", href: "#new-client" },
  { number: "05", label: "Update Client Content", href: "#content-updates" },
  { number: "06", label: "Change Brand and Design Tokens", href: "#brand-tokens" },
  { number: "07", label: "Build Pages from Components", href: "#build-pages" },
  { number: "08", label: "Add Images, Forms, Booking, and Links", href: "#integrations" },
  { number: "09", label: "Test Before Client Review", href: "#qa" },
  { number: "10", label: "Publish a Preview", href: "#publish-preview" },
  { number: "11", label: "Launch on Client Domain", href: "#launch-domain" },
  { number: "12", label: "Make Maintenance Updates", href: "#maintenance" },
  { number: "13", label: "Add a Reusable Component", href: "#contribute" },
  { number: "14", label: "Troubleshoot Common Errors", href: "#troubleshoot" },
  { number: "15", label: "Checklists", href: "#checklists" },
  { number: "16", label: "Changelog", href: "#changelog" }
];

const doneWhen = [
  "Client information is accurate and approved.",
  "The change appears correctly in the local browser preview.",
  "Mobile and desktop layouts are checked.",
  "npm run build completes successfully.",
  "The change is committed with a meaningful Git message.",
  "Cloudflare deployment succeeds.",
  "The preview or live site has been checked after deployment."
];

const updateTypes = [
  {
    request: "Business fact or content",
    where: "src/content/*.json",
    examples: "Phone, hours, services, FAQs, reviews, address, service areas"
  },
  {
    request: "Brand-wide visual style",
    where: "src/styles/theme.css",
    examples: "Colors, fonts, buttons, spacing, radius values"
  },
  {
    request: "Page order or selected content blocks",
    where: "src/pages/*.astro",
    examples: "Add, remove, or reorder sections on a page"
  },
  {
    request: "Reusable layout or function",
    where: "src/components/",
    examples: "New hero format, service layout, gallery, form component"
  },
  {
    request: "Hosting or domain",
    where: "Cloudflare Pages / domain registrar",
    examples: "DNS, redirects, deployment status, custom domain"
  },
  {
    request: "Third-party integration",
    where: "Client-owned service account",
    examples: "Forms, booking, CRM, analytics, ecommerce, payments"
  }
];

const troubleshooting = [
  {
    symptom: "Could not import ../styles/bootstrap.scss",
    cause: "A file is missing, the import path is wrong, the filename differs, or a hidden .txt extension was added.",
    fix: "Confirm src/styles/bootstrap.scss exists exactly and contains the Bootstrap Sass import.",
    escalate: "The file exists, the path and capitalization match, and the build still fails."
  },
  {
    symptom: "Unexpected token",
    cause: "Pasted Markdown fences, extra words such as text or q tags, a missing JSON comma, a missing Astro frontmatter marker, or invalid syntax.",
    fix: "Read the named file and line. Remove pasted formatting and compare the nearby code with a known working example.",
    escalate: "The file looks correct after checking the exact named line and the error remains."
  },
  {
    symptom: "Failed to resolve import",
    cause: "A component is missing, the path is incorrect, or capitalization differs from the real filename.",
    fix: "Confirm the exact component path and filename capitalization with find src/components -type f | sort.",
    escalate: "The file and import path match exactly but Astro still cannot resolve it."
  },
  {
    symptom: "Service cards do not show",
    cause: "Services were not imported, JSON is invalid, or the component was not given the data it expects.",
    fix: "Check src/content/services.json, then verify the page imports services and passes it to the service component.",
    escalate: "The JSON, import, and component props are correct but the section still renders empty."
  },
  {
    symptom: "FAQ does not open",
    cause: "The component may rely on Bootstrap JavaScript that is not loaded, or accordion IDs conflict.",
    fix: "If using Bootstrap accordion JavaScript, confirm the Bootstrap bundle is imported in BaseLayout.astro and each accordion ID is unique. Prefer native details and summary where possible.",
    escalate: "The required JavaScript and unique IDs are confirmed but interaction still fails."
  },
  {
    symptom: "Update works locally but not online",
    cause: "Files were not committed or pushed, the Cloudflare build failed, the wrong branch deployed, or the browser cached an old page.",
    fix: "Run git status, commit and push the intended files, inspect the Cloudflare deployment log, confirm the production branch, then hard refresh the browser.",
    escalate: "Cloudflare shows a successful deployment from the correct commit but the correct update never appears."
  },
  {
    symptom: "Demo content still appears",
    cause: "The wrong JSON file was edited, content is hard-coded in a component/page, or a second copy exists.",
    fix: "Search the project for the visible demo text, then update the source file or move repeated business facts into JSON.",
    escalate: "Search cannot find the displayed text or the component output is unclear."
  },
  {
    symptom: "npm run build fails",
    cause: "Invalid syntax, a missing import, invalid JSON, an empty dynamic route, or a missing package.",
    fix: "Fix the first useful error near the top of the output. Do not chase later stack-trace lines until the first named file and line are resolved.",
    escalate: "The first named error is resolved but the build keeps failing with an unclear new error."
  }
];

const cloneCommand = `git clone https://github.com/YOUR-ACCOUNT/client-business-name-website.git
cd client-business-name-website
npm install
npm run dev`;

const setupCommand = `node --version
npm --version
git --version`;

const publishCommand = `git status
git add .
git commit -m "Update business hours and service area"
git push`;

const buildCommand = `npm run build
npm run preview`;

const businessBefore = `{
  "businessName": "Demo Local Business",
  "phoneDisplay": "(408) 555-0198",
  "phoneLink": "+14085550198"
}`;

const businessAfter = `{
  "businessName": "Acme Plumbing",
  "phoneDisplay": "(408) 555-0142",
  "phoneLink": "+14085550142"
}`;

const serviceExample = `{
  "icon": "bi-droplet-fill",
  "title": "Drain Cleaning",
  "description": "Professional removal of clogs and drainage issues."
}`;

const testimonialExample = `{
  "quote": "The team was responsive, professional, and easy to work with from the first call through completion.",
  "name": "Jordan M.",
  "role": "Verified client review"
}`;

const faqExample = `---
import FAQ from "../components/sections/FAQ.astro";
import faq from "../content/faq.json";
---

<FAQ items={faq} />`;

const themeBefore = `:root {
  --bs-primary: #14532d;
  --brand-accent: #f59e0b;
  --font-heading: Arial, sans-serif;
  --font-body: Arial, sans-serif;
}`;

const themeAfter = `:root {
  --bs-primary: #0a4b78;
  --brand-accent: #e66a2c;
  --font-heading: "Poppins", sans-serif;
  --font-body: "Open Sans", sans-serif;
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Internal operating manual for building and maintaining client websites."
    />
    <title>How to Use | Client Website Master Library</title>
  </head>

  <body>
    <div class="library-page">
      <aside class="library-sidebar">
        <a class="library-brand" href="/library">
          <span class="library-brand-mark">CL</span>

          <span class="library-brand-copy">
            <span class="library-brand-title">Client Library</span>
            <span class="library-brand-subtitle">Operating manual</span>
          </span>
        </a>

        <div class="library-nav-group">
          <p class="library-nav-label">Internal system</p>

          <nav class="library-nav" aria-label="Internal system navigation">
            <a href="/library">
              <span class="library-nav-number">00</span>
              <span>Visual library</span>
            </a>

            <a class="is-active" href="#start-here">
              <span class="library-nav-number">01</span>
              <span>How to use</span>
            </a>
          </nav>
        </div>

        <div class="library-nav-group">
          <p class="library-nav-label">Guide sections</p>

          <nav class="library-nav" aria-label="Operating manual navigation">
            {guideNav.map((item) => (
              <a href={item.href}>
                <span class="library-nav-number">{item.number}</span>
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
        </div>

        <div class="library-sidebar-footer">
          <p>Guide = instruction + action + verification.</p>
          <p><a href="/library">Browse visual components</a></p>
        </div>
      </aside>

      <div class="library-main">
        <header class="library-topbar">
          <p class="library-topbar-title">How to Use the Client Website System</p>
          <span class="library-topbar-status">Internal reference</span>
        </header>

        <main>
          <section id="start-here" class="library-intro">
            <div class="library-intro-inner">
              <p class="library-kicker">Start here</p>

              <h1>Build client sites with confidence, even if you are new to the stack.</h1>

              <p class="library-intro-description">
                This guide explains why each task matters, exactly where to make the
                change, what to edit or run, how to confirm it worked, and what to do
                when something fails.
              </p>

              <div class="library-intro-actions">
                <a class="library-quick-link" href="#new-client">Start a New Client Site →</a>
                <a class="library-quick-link" href="#update-decision">Make an Update →</a>
                <a class="library-quick-link" href="/library">Browse Visual Library</a>
              </div>

              <div class="library-mobile-contents">
                <strong>Jump to a guide section</strong>

                <nav aria-label="Mobile operating manual navigation">
                  {guideNav.map((item) => (
                    <a href={item.href}>{item.number} {item.label}</a>
                  ))}
                </nav>
              </div>
            </div>
          </section>

          <div class="library-content">
            <section class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">Quickstart outcome</p>
                  <h2>Create a branded private client preview</h2>
                </div>

                <span class="library-badge">Start here</span>
              </div>

              <div class="library-preview library-preview--white">
                <div class="guide-meta-grid">
                  <article class="guide-meta-card">
                    <span>Goal</span>
                    <strong>Create a private, branded client website from the master library and publish a Cloudflare Pages preview link.</strong>
                  </article>

                  <article class="guide-meta-card">
                    <span>Expected output</span>
                    <strong>A working .pages.dev preview URL ready for review before connecting a custom domain.</strong>
                  </article>

                  <article class="guide-meta-card">
                    <span>Typical time</span>
                    <strong>2–6 hours for a standard starter website after approved content is received.</strong>
                  </article>

                  <article class="guide-meta-card">
                    <span>Owner</span>
                    <strong>Assigned website builder, with client approval at review and launch stages.</strong>
                  </article>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Before starting, collect</h3>

                  <ul>
                    <li>Approved business name and short description</li>
                    <li>Logo, colors, fonts, and brand assets</li>
                    <li>Phone, email, address, hours, and service areas</li>
                    <li>Services and service descriptions</li>
                    <li>Genuine reviews approved for publication</li>
                    <li>Approved pages and primary call to action</li>
                    <li>Images, permissions, and relevant licenses</li>
                    <li>Domain and account ownership status</li>
                    <li>Required form, booking, CRM, analytics, ecommerce, or payment tools</li>
                  </ul>
                </div>

                <aside class="library-note library-note--warning">
                  <strong>Do not start from guesses:</strong> confirm business facts,
                  claims, reviews, photos, service coverage, pricing, booking links,
                  and legal requirements before launch.
                </aside>
              </div>
            </section>

            <section id="computer-setup" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">02 — Set up your computer</p>
                  <h2>Install the few tools you need</h2>
                </div>

                <p class="library-component-file">
                  Output: <code>working local development environment</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="guide-step-grid">
                  <article class="guide-step-card">
                    <span class="guide-step-number">1</span>
                    <h3>Install Node.js</h3>
                    <p>Node.js runs the project tools. npm is included with it and installs project packages.</p>
                    <pre class="library-code-block"><code set:text={setupCommand}></code></pre>
                  </article>

                  <article class="guide-step-card">
                    <span class="guide-step-number">2</span>
                    <h3>Install Git</h3>
                    <p>Git tracks file history and sends your work to GitHub.</p>
                    <pre class="library-code-block"><code>git --version</code></pre>
                  </article>

                  <article class="guide-step-card">
                    <span class="guide-step-number">3</span>
                    <h3>Install an editor</h3>
                    <p>Use VS Code or another code editor. Open the project folder, not individual files.</p>
                    <pre class="library-code-block"><code>code .</code></pre>
                  </article>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Verify it worked</h3>
                  <p>
                    Each terminal command should return a version number. If <code>code .</code>
                    does not work, open VS Code manually and choose <code>File → Open Folder</code>.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Plain language:</strong> Terminal is a text-based way to run
                  commands. It does not change anything until you run a command.
                </aside>
              </div>
            </section>

            <section id="understand-project" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">03 — Understand the project</p>
                  <h2>Know where each kind of change belongs</h2>
                </div>

                <p class="library-component-file">Start here before editing files</p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="system-flow" aria-label="Website project workflow">
                  <div>MASTER LIBRARY</div>
                  <span>↓ duplicate for each signed client</span>
                  <div>CLIENT-SPECIFIC PRIVATE REPOSITORY</div>
                  <span>↓ edit content, branding, and page selection</span>
                  <div>GITHUB</div>
                  <span>↓ push changes</span>
                  <div>CLOUDFLARE PAGES</div>
                  <span>↓ automatic build and hosting</span>
                  <div>PREVIEW URL → CLIENT REVIEW → CLIENT DOMAIN → LIVE WEBSITE</div>
                </div>

                <div id="update-decision" class="decision-tree">
                  <h3>Where should I make this change?</h3>

                  <div class="decision-tree__question">
                    A client wants a website change
                  </div>

                  <div class="decision-tree__branch">
                    <article>
                      <h4>Is it factual content?</h4>
                      <p>Name, phone, email, hours, services, FAQ, testimonial, copy, or service area.</p>
                      <strong>Yes → Edit a JSON file in <code>src/content/</code></strong>
                    </article>

                    <article>
                      <h4>Is it brand-wide appearance?</h4>
                      <p>Colors, fonts, spacing, button style, or shared visual tokens.</p>
                      <strong>Yes → Edit <code>src/styles/theme.css</code></strong>
                    </article>

                    <article>
                      <h4>Is it page order?</h4>
                      <p>Add, remove, or reorder selected sections for one page.</p>
                      <strong>Yes → Edit the relevant file in <code>src/pages/</code></strong>
                    </article>

                    <article>
                      <h4>Is a reusable layout needed?</h4>
                      <p>A new section, hero format, interaction, or shared function.</p>
                      <strong>Yes → Build in <code>src/components/</code>; only add to master after testing.</strong>
                    </article>
                  </div>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Plain-language model</h3>

                  <ul>
                    <li><strong>JSON:</strong> factual client content and structured data.</li>
                    <li><strong>theme.css:</strong> brand-wide appearance such as colors, typography, spacing, and shapes.</li>
                    <li><strong>Components:</strong> reusable layouts and interface behavior.</li>
                    <li><strong>Pages:</strong> selected component order and page structure.</li>
                    <li><strong>Master library:</strong> team-owned, reusable, tested improvements only.</li>
                    <li><strong>Client repository:</strong> private, client-specific website work.</li>
                  </ul>
                </div>

                <aside class="library-note library-note--success">
                  <strong>Default rule:</strong> normal content changes should be made
                  in JSON before editing components.
                </aside>
              </div>
            </section>

            <section id="new-client" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">04 — Start a new client website</p>
                  <h2>Follow the 10 milestones in order</h2>
                </div>

                <p class="library-component-file">
                  Guide: <code>docs/new-client-setup.md</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="milestone-list">
                  <article class="milestone-card">
                    <span class="guide-step-number">1</span>
                    <h3>Duplicate the master repository</h3>
                    <p><strong>Purpose:</strong> create a private client-specific copy while protecting the reusable master library.</p>
                    <p><strong>What you need:</strong> approved client project name and private GitHub repository access.</p>
                    <pre class="library-code-block"><code set:text={cloneCommand}></code></pre>
                    <p><strong>Verify:</strong> Terminal shows a local development URL, usually <code>http://localhost:4321</code>.</p>
                    <p><strong>Common problem:</strong> repository not found. First check the GitHub URL, account access, and repository privacy settings.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">2</span>
                    <h3>Run the site locally</h3>
                    <p><strong>Purpose:</strong> preview changes safely on your computer before anyone else sees them.</p>
                    <p><strong>Action:</strong> keep <code>npm run dev</code> running, then open the local address in your browser.</p>
                    <p><strong>Verify:</strong> the homepage opens and the terminal shows no errors.</p>
                    <p><strong>Done when:</strong> you can view <code>/</code>, <code>/services</code>, <code>/contact</code>, and <code>/library</code> locally.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">3</span>
                    <h3>Update client business details</h3>
                    <p><strong>Purpose:</strong> replace demo identity and contact information across the site from one central location.</p>
                    <p><strong>File:</strong> <code>src/content/site.json</code></p>
                    <p><strong>Verify:</strong> check header, hero, footer, contact page, and phone link.</p>
                    <p><strong>First fix:</strong> if changes do not appear, confirm you saved the file and edited the client repository rather than the master library.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">4</span>
                    <h3>Apply client branding</h3>
                    <p><strong>Purpose:</strong> make the reusable system visually belong to the client without rewriting every component.</p>
                    <p><strong>File:</strong> <code>src/styles/theme.css</code></p>
                    <p><strong>Verify:</strong> inspect buttons, headings, cards, navigation, dark sections, and mobile views.</p>
                    <p><strong>First fix:</strong> if a color does not change, search for a hard-coded color in the affected component.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">5</span>
                    <h3>Replace services, reviews, FAQs, and images</h3>
                    <p><strong>Purpose:</strong> turn the starter into an accurate client site.</p>
                    <p><strong>Files:</strong> <code>src/content/services.json</code>, <code>testimonials.json</code>, <code>faq.json</code>, and approved assets.</p>
                    <p><strong>Verify:</strong> no demo text, placeholder images, or sample logos remain.</p>
                    <p><strong>First fix:</strong> search the project for visible demo wording if you cannot find where it comes from.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">6</span>
                    <h3>Assemble client pages</h3>
                    <p><strong>Purpose:</strong> select the best components for the client’s business goal and visitor needs.</p>
                    <p><strong>Files:</strong> normally <code>src/pages/index.astro</code>, <code>services.astro</code>, <code>about.astro</code>, and <code>contact.astro</code>.</p>
                    <p><strong>Verify:</strong> headings are logical, sections are useful, and each page has one clear action.</p>
                    <p><strong>First fix:</strong> use an industry example in <code>/library</code> instead of inventing a page structure from scratch.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">7</span>
                    <h3>Test locally</h3>
                    <p><strong>Purpose:</strong> catch content, layout, link, and build failures before client review.</p>
                    <pre class="library-code-block"><code>npm run build</code></pre>
                    <p><strong>Verify:</strong> the command finishes successfully and creates a production build.</p>
                    <p><strong>First fix:</strong> resolve the first named file and line in the error output.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">8</span>
                    <h3>Push to GitHub and deploy preview</h3>
                    <p><strong>Purpose:</strong> create a shareable review URL.</p>
                    <pre class="library-code-block"><code set:text={publishCommand}></code></pre>
                    <p><strong>Verify:</strong> Cloudflare Pages shows a successful deployment and provides a <code>.pages.dev</code> URL.</p>
                    <p><strong>First fix:</strong> inspect the Cloudflare build log if deployment fails.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">9</span>
                    <h3>Collect feedback and revisions</h3>
                    <p><strong>Purpose:</strong> keep review organized and avoid accidental scope changes.</p>
                    <p><strong>Action:</strong> collect feedback in one written list, classify each request, confirm scope, then update and redeploy.</p>
                    <p><strong>Verify:</strong> client can see revisions at the preview URL and confirms outstanding decisions.</p>
                  </article>

                  <article class="milestone-card">
                    <span class="guide-step-number">10</span>
                    <h3>Get launch approval and connect domain</h3>
                    <p><strong>Purpose:</strong> publish only after the client approves the exact version and account ownership is clear.</p>
                    <p><strong>Verify:</strong> written approval exists, custom domain works with HTTPS, and every critical action is retested live.</p>
                    <p><strong>First fix:</strong> do not change DNS until the client confirms account ownership and gives written approval.</p>
                  </article>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Important local-preview note</h3>
                  <p>
                    The local development address is normally <code>http://localhost:4321</code>.
                    It is visible only on your computer until you deploy a preview.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Placeholder reminder:</strong> replace <code>YOUR-ACCOUNT</code>
                  and <code>client-business-name-website</code> in the clone command with the
                  actual GitHub account and repository name.
                </aside>
              </div>
            </section>

            <section id="content-updates" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">05 — Update client content</p>
                  <h2>Edit facts in JSON, not repeated page markup</h2>
                </div>

                <p class="library-component-file">
                  Folder: <code>src/content/</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <article class="recipe-card">
                  <div class="recipe-card__heading">
                    <div>
                      <span class="library-badge">Content recipe</span>
                      <h3>Update client business details</h3>
                    </div>

                    <code>src/content/site.json</code>
                  </div>

                  <div class="recipe-columns">
                    <div>
                      <h4>Use this when</h4>
                      <p>The business name, phone, email, address, hours, service area, social links, primary CTA, or legal name changes.</p>

                      <h4>Do not use this when</h4>
                      <p>The request changes visual design, layout, or the order of page sections.</p>

                      <h4>What it controls</h4>
                      <p>Shared factual business data used in header, hero, footer, contact routes, SEO, and other reused components.</p>
                    </div>

                    <div>
                      <h4>Before</h4>
                      <pre class="library-code-block"><code set:text={businessBefore}></code></pre>

                      <h4>After</h4>
                      <pre class="library-code-block"><code set:text={businessAfter}></code></pre>
                    </div>
                  </div>

                  <div class="recipe-actions">
                    <div>
                      <h4>Exact steps</h4>

                      <ol>
                        <li>Open <code>src/content/site.json</code>.</li>
                        <li>Replace only approved factual values.</li>
                        <li>Save the file.</li>
                        <li>Run <code>npm run dev</code> and inspect affected pages.</li>
                        <li>Click the phone link in a narrow/mobile browser view.</li>

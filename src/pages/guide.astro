
---
import "../styles/library.css";

const guideNav = [
  { number: "01", label: "Start Here", href: "#start-here" },
  { number: "02", label: "Set Up Your Computer", href: "#computer-setup" },
  { number: "03", label: "Understand the Project", href: "#understand-project" },
  { number: "04", label: "Start a New Client Website", href: "#new-client" },
  { number: "05", label: "Update Client Content", href: "#content-updates" },
  { number: "06", label: "Change Brand and Design Tokens", href: "#brand-tokens" },
  { number: "07", label: "Build Pages from Components", href: "#build-pages" },
  { number: "08", label: "Add Images, Forms, Booking, and Links", href: "#integrations" },
  { number: "09", label: "Test Before Client Review", href: "#qa" },
  { number: "10", label: "Publish a Preview", href: "#publish-preview" },
  { number: "11", label: "Launch on Client Domain", href: "#launch-domain" },
  { number: "12", label: "Make Maintenance Updates", href: "#maintenance" },
  { number: "13", label: "Add a Reusable Component", href: "#contribute" },
  { number: "14", label: "Troubleshoot Common Errors", href: "#troubleshoot" },
  { number: "15", label: "Checklists", href: "#checklists" },
  { number: "16", label: "Changelog", href: "#changelog" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>How to Use | Client Website Master Library</title>
  </head>

  <body>
    <div class="library-page">
      <aside class="library-sidebar">
        <a class="library-brand" href="/library">
          <span class="library-brand-mark">CL</span>

          <span class="library-brand-copy">
            <span class="library-brand-title">Client Library</span>
            <span class="library-brand-subtitle">Operating manual</span>
          </span>
        </a>

        <div class="library-nav-group">
          <p class="library-nav-label">Internal system</p>

          <nav class="library-nav" aria-label="Internal system navigation">
            <a href="/library">
              <span class="library-nav-number">00</span>
              <span>Visual library</span>
            </a>

            <a class="is-active" href="#start-here">
              <span class="library-nav-number">01</span>
              <span>How to use</span>
            </a>
          </nav>
        </div>

        <div class="library-nav-group">
          <p class="library-nav-label">Guide sections</p>

          <nav class="library-nav" aria-label="Operating manual navigation">
            {guideNav.map((item) => (
              <a href={item.href}>
                <span class="library-nav-number">{item.number}</span>
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <div class="library-main">
        <header class="library-topbar">
          <p class="library-topbar-title">How to Use the Client Website System</p>
          <span class="library-topbar-status">Internal reference</span>
        </header>

        <main>
          <section id="start-here" class="library-intro">
            <div class="library-intro-inner">
              <p class="library-kicker">Start here</p>

              <h1>Client Website Operating Manual</h1>

              <p class="library-intro-description">
                Use this guide to create, update, test, deploy, and maintain client
                websites built from the master library.
              </p>

              <div class="library-intro-actions">
                <a class="library-quick-link" href="#new-client">
                  Start a New Client Site →
                </a>

                <a class="library-quick-link" href="#content-updates">
                  Make an Update →
                </a>

                <a class="library-quick-link" href="/library">
                  Browse Visual Library
                </a>
              </div>
            </div>
          </section>

          <div class="library-content">
            <section id="computer-setup" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">02 — Set up your computer</p>
                  <h2>Check your local tools</h2>
                </div>

                <p class="library-component-file">
                  Goal: <code>run Astro locally</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <pre class="library-code-block"><code>node --version
npm --version
git --version</code></pre>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Why</h3>
                  <p>
                    Node.js runs Astro tools, npm installs dependencies, and Git tracks
                    your work and sends it to GitHub.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Done when:</strong> each command returns a version number.
                </aside>
              </div>
            </section>

            <section id="understand-project" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">03 — Understand the project</p>
                  <h2>Know where to make changes</h2>
                </div>

                <p class="library-component-file">
                  Rule: <code>content first, components second, pages third</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="system-flow">
                  <div>MASTER LIBRARY</div>
                  <span>↓ duplicate for each signed client</span>
                  <div>CLIENT-SPECIFIC PRIVATE REPOSITORY</div>
                  <span>↓ update content, branding, and page selection</span>
                  <div>GITHUB</div>
                  <span>↓ push changes</span>
                  <div>CLOUDFLARE PAGES</div>
                  <span>↓ build and publish preview</span>
                  <div>PREVIEW URL → CLIENT REVIEW → CLIENT DOMAIN → LIVE WEBSITE</div>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Where changes belong</h3>
                  <ul>
                    <li><code>src/content/</code> — business facts, services, reviews, FAQs, and service areas</li>
                    <li><code>src/styles/theme.css</code> — colors, fonts, spacing, and shared brand styling</li>
                    <li><code>src/components/</code> — reusable layouts and interactions</li>
                    <li><code>src/pages/</code> — page structure and component order</li>
                  </ul>
                </div>

                <aside class="library-note library-note--success">
                  <strong>Default:</strong> change JSON first when a client changes a fact.
                </aside>
              </div>
            </section>

            <section id="new-client" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">04 — Start a new client website</p>
                  <h2>Start from a private client repository</h2>
                </div>

                <p class="library-component-file">
                  Guide: <code>docs/new-client-setup.md</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <pre class="library-code-block"><code>git clone https://github.com/YOUR-ACCOUNT/client-business-name-website.git
cd client-business-name-website
npm install
npm run dev</code></pre>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Verify</h3>
                  <p>
                    Open the local URL printed in Terminal. It is usually
                    <code>http://localhost:4321</code> and is visible only on your computer.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Replace placeholders:</strong> substitute YOUR-ACCOUNT and
                  client-business-name-website with the real private GitHub repository.
                </aside>
              </div>
            </section>

            <section id="content-updates" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">05 — Update client content</p>
                  <h2>Business details belong in JSON</h2>
                </div>

                <p class="library-component-file">
                  File: <code>src/content/site.json</code>
                </p>
              </div>

            <div class="library-preview library-preview--white">
  <pre class="library-code-block"><code set:text={`{
  "businessName": "Acme Plumbing",
  "phoneDisplay": "(408) 555-0142",
  "phoneLink": "+14085550142"
}`}></code></pre>
</div>

              <div class="library-docs">
                <div>
                  <h3>Verify</h3>
                  <p>
                    Check the name and number in Header, Hero, Footer, and Contact page.
                    Click the phone link in a narrow browser view.
                  </p>
                </div>

                <aside class="library-note library-note--warning">
                  <strong>JSON rule:</strong> use double quotes and do not leave a comma
                  after the final item in a list or object.
                </aside>
              </div>
            </section>

            <section id="brand-tokens" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">06 — Change brand and design tokens</p>
                  <h2>Update shared design values</h2>
                </div>

                <p class="library-component-file">
                  File: <code>src/styles/theme.css</code>
                </p>
              </div>

          <div class="library-preview library-preview--white">
  <pre class="library-code-block"><code set:text={`:root {
  --color-primary: #0a4b78;
  --color-accent: #e66a2c;
}`}></code></pre>
</div>
              <div class="library-docs">
                <div>
                  <h3>Verify</h3>
                  <p>
                    Review buttons, headings, links, cards, dark sections, and mobile
                    navigation after any brand-wide token change.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Rule:</strong> change token values before adding one-off component colors.
                </aside>
              </div>
            </section>

            <section id="build-pages" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">07 — Build pages from components</p>
                  <h2>Use the visual library to choose sections</h2>
                </div>

                <p class="library-component-file">
                  Visual tool: <code>/library</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <ol class="library-checklist">
                  <li>Choose the closest industry example.</li>
                  <li>Update approved content and brand data first.</li>
                  <li>Open the page file, such as <code>src/pages/index.astro</code>.</li>
                  <li>Import the needed reusable components.</li>
                  <li>Arrange components around one primary visitor action.</li>
                  <li>Test desktop, tablet, and mobile layouts.</li>
                </ol>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Recommended service homepage order</h3>
                  <p>
                    Header → Hero → Trust proof → Services → Why choose us →
                    Testimonials → Process → FAQ → Contact CTA → Footer.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Do not overbuild:</strong> choose only sections that support a real
                  business goal and visitor decision.
                </aside>
              </div>
            </section>

            <section id="integrations" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">08 — Add images, forms, booking, and links</p>
                  <h2>Test real actions end to end</h2>
                </div>

                <p class="library-component-file">
                  Assets: <code>src/assets/</code> · <code>public/</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <ol class="library-checklist">
                  <li>Use only client-supplied, licensed, or permission-cleared images.</li>
                  <li>Use meaningful image names such as <code>acme-plumbing-technician.jpg</code>.</li>
                  <li>Use client-owned accounts for booking, CRM, analytics, ecommerce, and payments where possible.</li>
                  <li>Submit a real form test and confirm it reaches the intended recipient.</li>
                  <li>Test every phone, email, map, booking, payment, social, and download link.</li>
                </ol>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Security rule</h3>
                  <p>
                    Never place API keys, passwords, contracts, client intake forms,
                    credentials, or private data in public repositories or the
                    <code>public/</code> directory.
                  </p>
                </div>

                <aside class="library-note library-note--warning">
                  <strong>Do not claim:</strong> a form or integration works until it has been
                  tested using the client’s real destination.
                </aside>
              </div>
            </section>

            <section id="qa" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">09 — Test before client review</p>
                  <h2>Verify the production build</h2>
                </div>

                <p class="library-component-file">
                  Commands: <code>npm run build</code> · <code>npm run preview</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <pre class="library-code-block"><code>npm run build
npm run preview</code></pre>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Done when</h3>
                  <ul>
                    <li>Business facts are accurate and approved.</li>
                    <li>Desktop and mobile layouts are checked.</li>
                    <li>Links, phone actions, forms, and CTAs work.</li>
                    <li>No demo copy, placeholder images, fake reviews, or unfinished pages remain.</li>
                    <li>The production build succeeds.</li>
                  </ul>
                </div>

                <aside class="library-note library-note--success">
                  <strong>Definition of done:</strong> a saved file is not complete until its
                  visible result is tested locally and after deployment.
                </aside>
              </div>
            </section>

            <section id="publish-preview" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">10 — Publish a preview</p>
                  <h2>Commit, push, and verify deployment</h2>
                </div>

                <p class="library-component-file">
                  Output: <code>.pages.dev preview</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <pre class="library-code-block"><code>git status
git add .
git commit -m "Update business hours and service area"
git push</code></pre>
              </div>

              <div class="library-docs">
                <div>
                  <h3>What happens</h3>
                  <p>
                    GitHub receives your files. Cloudflare Pages detects the push,
                    runs the build, creates the site in <code>dist</code>, and publishes
                    the deployment.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Verify:</strong> confirm Cloudflare reports success, open the target
                  page, check the requested update, then test the relevant call to action.
                </aside>
              </div>
            </section>

            <section id="launch-domain" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">11 — Launch on client domain</p>
                  <h2>Launch only with ownership and approval clear</h2>
                </div>

                <p class="library-component-file">
                  Owner: <code>client domain and paid accounts</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <ol class="library-checklist">
                  <li>Get written approval to launch the reviewed version.</li>
                  <li>Connect the custom domain in Cloudflare Pages.</li>
                  <li>Configure DNS in the client-owned account.</li>
                  <li>Confirm HTTPS and intended root/www behavior.</li>
                  <li>Re-test every critical page, CTA, form, and link on the live domain.</li>
                  <li>Record launch date, access owner, deployment, and recurring tool costs.</li>
                </ol>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Ownership rules</h3>
                  <p>
                    The client should own the domain registrar and relevant paid services.
                    The team receives needed collaborator access. The reusable master
                    library remains team-owned.
                  </p>
                </div>

                <aside class="library-note library-note--warning">
                  <strong>Never store credentials:</strong> do not commit passwords, API secrets,
                  recovery codes, or access tokens into the repository.
                </aside>
              </div>
            </section>

            <section id="maintenance" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">12 — Make maintenance updates</p>
                  <h2>Classify, edit, test, publish, verify</h2>
                </div>

                <p class="library-component-file">
                  Rule: <code>content first</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="library-table-wrap">
                  <table class="library-table">
                    <thead>
                      <tr>
                        <th>Request type</th>
                        <th>First place to look</th>
                        <th>Typical examples</th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>Business fact or content</td>
                        <td><code>src/content/*.json</code></td>
                        <td>Phone, hours, services, FAQs, reviews</td>
                      </tr>

                      <tr>
                        <td>Brand-wide visual style</td>
                        <td><code>src/styles/theme.css</code></td>
                        <td>Colors, fonts, buttons, spacing</td>
                      </tr>

                      <tr>
                        <td>Page order or blocks</td>
                        <td><code>src/pages/*.astro</code></td>
                        <td>Add, remove, reorder sections</td>
                      </tr>

                      <tr>
                        <td>Reusable layout or feature</td>
                        <td><code>src/components/</code></td>
                        <td>New hero, gallery, form section</td>
                      </tr>

                      <tr>
                        <td>Hosting or domain</td>
                        <td>Cloudflare / registrar</td>
                        <td>DNS, redirects, deployment status</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Maintenance flow</h3>
                  <p>
                    Request received → classify → confirm scope/approval → edit →
                    local test → production build → Git commit/push → Cloudflare deploy →
                    live verification → client notification → document result.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>First question:</strong> what kind of request is this? Do not edit
                  components until you know JSON or theme.css is not the correct location.
                </aside>
              </div>
            </section>

            <section id="contribute" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">13 — Add a reusable component</p>
                  <h2>Improve the master deliberately</h2>
                </div>

                <p class="library-component-file">
                  Folder: <code>src/components/</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <ol class="library-checklist">
                  <li>Confirm multiple future clients will likely need the component.</li>
                  <li>Build and test it in a client branch or safe prototype first.</li>
                  <li>Remove client names, branding, images, private logic, and hard-coded facts.</li>
                  <li>Use props or JSON for flexible content.</li>
                  <li>Add a preview and clear documentation to the visual library.</li>
                  <li>Test desktop, mobile, accessibility, and production build behavior.</li>
                  <li>Update the changelog.</li>
                  <li>Merge deliberately and decide separately whether existing clients should upgrade.</li>
                </ol>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Protection rule</h3>
                  <p>
                    Do not copy every client-specific request into the master library.
                    The master holds only reusable, generic, tested improvements.
                  </p>
                </div>

                <aside class="library-note library-note--warning">
                  <strong>Do not force upgrades:</strong> a better master component does not
                  automatically require changes to every existing client website.
                </aside>
              </div>
            </section>

            <section id="troubleshoot" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">14 — Troubleshoot common errors</p>
                  <h2>Fix the first useful error first</h2>
                </div>

                <p class="library-component-file">
                  Rule: <code>read file path + line number</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="library-table-wrap">
                  <table class="library-table">
                    <thead>
                      <tr>
                        <th>Symptom</th>
                        <th>First fix</th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td><code>Unexpected token</code></td>
                        <td>Check the named file and line for copied Markdown fences, missing JSON commas, missing Astro frontmatter markers, or pasted non-code words.</td>
                      </tr>

                      <tr>
                        <td><code>Failed to resolve import</code></td>
                        <td>Confirm the component exists and the import path and capitalization match exactly.</td>
                      </tr>

                      <tr>
                        <td>Service cards are missing</td>
                        <td>Validate services JSON, then confirm the data import and component usage.</td>
                      </tr>

                      <tr>
                        <td>Works locally, not online</td>
                        <td>Run git status, commit/push changes, inspect Cloudflare build logs, confirm correct branch, then hard refresh.</td>
                      </tr>

                      <tr>
                        <td><code>npm run build</code> fails</td>
                        <td>Fix the first named error. Ignore later stack-trace lines until the first file and line are resolved.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>When asking for help</h3>
                  <p>
                    Copy the first error message, the file path, the line number, and
                    about ten lines around the error. This gives enough information to
                    identify the actual problem.
                  </p>
                </div>

                <aside class="library-note library-note--success">
                  <strong>Good habit:</strong> change one thing, test again, then continue.
                </aside>
              </div>
            </section>

            <section id="checklists" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">15 — Checklists</p>
                  <h2>Definition of done for major tasks</h2>
                </div>

                <p class="library-component-file">
                  Files: <code>docs/qa-checklist.md</code> · <code>docs/launch-checklist.md</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <ul class="library-checklist">
                  <li>Client information is accurate and approved.</li>
                  <li>The change appears correctly in the local browser preview.</li>
                  <li>Mobile and desktop layouts are checked.</li>
                  <li>npm run build completes successfully.</li>
                  <li>The change is committed with a meaningful Git message.</li>
                  <li>Cloudflare deployment succeeds.</li>
                  <li>The preview or live site has been checked after deployment.</li>
                </ul>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Use supporting documents</h3>
                  <p>
                    Use docs/qa-checklist.md before review, docs/launch-checklist.md
                    before custom-domain launch, and docs/client-handoff.md for ownership
                    and support handoff.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Completion means verified:</strong> changing a file is not the
                  same as confirming the correct update is visible and working.
                </aside>
              </div>
            </section>

            <section id="changelog" class="library-section">
              <div class="library-section-heading">
                <div>
                  <p class="library-section-number">16 — Changelog</p>
                  <h2>Document deliberate master-library upgrades</h2>
                </div>

                <p class="library-component-file">
                  File: <code>docs/changelog.md</code>
                </p>
              </div>

              <div class="library-preview library-preview--white">
                <div class="library-table-wrap">
                  <table class="library-table">
                    <thead>
                      <tr>
                        <th>Date</th>
                        <th>Change summary</th>
                        <th>Affected files</th>
                        <th>Status</th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>2026-09-15</td>
                        <td>Added a separate operating manual while retaining the visual component library.</td>
                        <td><code>src/pages/guide.astro</code></td>
                        <td><span class="library-badge">Documented</span></td>
                      </tr>

                      <tr>
                        <td>YYYY-MM-DD</td>
                        <td>Describe reusable improvement and upgrade instructions.</td>
                        <td><code>affected/file.astro</code></td>
                        <td><span class="library-badge library-badge--draft">Add test status</span></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="library-docs">
                <div>
                  <h3>Include every time</h3>
                  <p>
                    Record the date, change summary, exact files affected, upgrade
                    instructions, tested status, limitations, and whether existing client
                    websites should consider adopting the improvement.
                  </p>
                </div>

                <aside class="library-note">
                  <strong>Master-only:</strong> do not put normal client-specific updates in
                  the master-library changelog.
                </aside>
              </div>
            </section>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

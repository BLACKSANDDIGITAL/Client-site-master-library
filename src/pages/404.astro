---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import PhoneCTA from "../components/ui/PhoneCTA.astro";
import site from "../content/site.json";
---

<BaseLayout
  title={`Page Not Found | ${site.businessName}`}
  description="The page you requested could not be found."
  noindex={true}
>
  <main class="not-found">
    <div class="content-container">
      <p class="eyebrow">Error 404</p>
      <h1>We could not find that page.</h1>
      <p>
        The page may have moved, the link may be incorrect, or it may no longer exist.
      </p>

      <div class="actions">
        <Button href="/">Return to homepage</Button>
        <PhoneCTA />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: var(--space-6);
    background: linear-gradient(135deg, var(--color-secondary), var(--color-surface));
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: 0.84rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  p:not(.eyebrow) {
    max-width: 620px;
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>

{
  "id": "service-enquiry",
  "name": "Service Enquiries",
  "description": "General service business website that generates estimate requests and phone calls.",
  "ctaBehavior": {
    "primary": { "label": "Request a Free Estimate", "destination": "/contact", "type": "enquiry" },
    "secondary": { "label": "Call Us Today", "destination": "tel:", "type": "phone" }
  },
  "pages": [
    {
      "name": "Homepage",
      "route": "/",
      "sections": ["Hero", "TrustBar", "ServicesGrid", "ImageText", "WhyChooseUs", "ProcessSteps", "Testimonials", "ServiceArea", "FAQ", "ContactCTA"],
      "required": ["Hero", "ServicesGrid", "ContactCTA"],
      "optional": ["TrustBar", "ImageText", "WhyChooseUs", "ProcessSteps", "Testimonials", "ServiceArea", "FAQ"]
    },
    {
      "name": "Services listing",
      "route": "/services",
      "sections": ["PageHero", "ServicesGrid", "ContactCTA"],
      "required": ["ServicesGrid"],
      "optional": ["ContactCTA"]
    },
    {
      "name": "Service detail",
      "route": "/services/[slug]",
      "sections": ["ServiceHero", "BenefitsList", "IncludedList", "ProcessSteps", "FAQ", "RelatedServices", "ContactCTA"],
      "required": ["ServiceHero", "BenefitsList"],
      "optional": ["IncludedList", "ProcessSteps", "FAQ", "RelatedServices", "ContactCTA"]
    },
    {
      "name": "About",
      "route": "/about",
      "sections": ["PageHero", "ImageText", "TeamGrid", "ServiceArea", "ContactCTA"],
      "required": ["PageHero"],
      "optional": ["ImageText", "TeamGrid", "ServiceArea", "ContactCTA"]
    },
    {
      "name": "Contact",
      "route": "/contact",
      "sections": ["PageHero", "ContactDetails", "ContactForm", "PhoneCTA"],
      "required": ["PageHero", "ContactForm"],
      "optional": ["ContactDetails", "PhoneCTA"]
    },
    {
      "name": "Privacy Policy",
      "route": "/privacy",
      "sections": ["PageHero", "ProseContent"],
      "required": ["PageHero", "ProseContent"],
      "optional": []
    },
    {
      "name": "Terms",
      "route": "/terms",
      "sections": ["PageHero", "ProseContent"],
      "required": ["PageHero", "ProseContent"],
      "optional": []
    },
    {
      "name": "Accessibility",
      "route": "/accessibility",
      "sections": ["PageHero", "ProseContent"],
      "required": ["PageHero", "ProseContent"],
      "optional": []
    },
    {
      "name": "404",
      "route": "/404",
      "sections": ["ErrorContent"],
      "required": ["ErrorContent"],
      "optional": []
    },
    {
      "name": "Thank You",
      "route": "/thank-you",
      "sections": ["ThankYouContent"],
      "required": ["ThankYouContent"],
      "optional": []
    }
  ],
  "contentRequirements": {
    "site": ["businessName", "phoneDisplay", "phoneLink", "email", "address", "hours", "serviceAreas", "primaryCta"],
    "services": ["slug", "name", "shortDescription", "description", "benefits", "included"],
    "navigation": ["main", "footer"],
    "testimonials": ["quote", "name"],
    "faq": ["question", "answer"],
    "serviceAreas": ["name", "slug", "description"]
  },
  "imageRoles": ["hero", "service-card", "about", "gallery", "team-member", "project", "service-area"],
  "validationRules": {
    "slugs": "lowercase-kebab-case",
    "requiredDestinations": ["/contact", "/services"],
    "phoneFormat": "E.164 with + prefix",
    "emailFormat": "valid email address"
  }
}

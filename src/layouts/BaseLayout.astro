---
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Demo Local Business",
  description = "Reliable service for homes and businesses in the local area.",
  image = "/og-default.jpg",
  noindex = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEOHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
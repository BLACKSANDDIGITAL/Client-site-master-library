---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Component Library",
  description = "Internal preview of reusable website components."
} = Astro.props;

const sections = [
  { href: "#overview", label: "Overview", number: "00" },
  { href: "#heroes", label: "Heroes", number: "01" },
  { href: "#services", label: "Services", number: "02" },
  { href: "#testimonials", label: "Testimonials", number: "03" },
  { href: "#faq", label: "FAQs", number: "04" },
  { href: "#cta", label: "Calls to action", number: "05" }
];
---

<BaseLayout title={title} description={description}>
  <div class="library-shell">
    <aside class="library-sidebar" aria-label="Component library navigation">
      <a class="library-brand" href="#overview">
        <span class="library-brand-mark" aria-hidden="true">CL</span>

        <span>
          <strong>Client Library</strong>
          <small>Master template</small>
        </span>
      </a>

      <nav class="library-nav" aria-label="Library sections">
        <p class="library-nav-label">Browse components</p>

        <ul>
          {
            sections.map((section) => (
              <li>
                <a href={section.href}>
                  <span>{section.number}</span>
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="library-sidebar-footer">
        <a class="btn btn-outline-light btn-sm w-100" href="/">
          <i class="bi bi-box-arrow-up-right me-2"></i>
          View demo site
        </a>

        <p>Internal tool — do not link in client navigation.</p>
      </div>
    </aside>

    <div class="library-content">
      <header class="library-mobile-header">
        <a class="library-mobile-brand" href="#overview">
          <span class="library-brand-mark" aria-hidden="true">CL</span>
          <span>Client Library</span>
        </a>

        <button
          class="btn btn-outline-dark btn-sm"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#libraryNavigation"
          aria-controls="libraryNavigation"
        >
          <i class="bi bi-list me-1"></i>
          Sections
        </button>
      </header>

      <div
        class="offcanvas offcanvas-start"
        tabindex="-1"
        id="libraryNavigation"
        aria-labelledby="libraryNavigationLabel"
      >
        <div class="offcanvas-header border-bottom">
          <h2 class="h5 mb-0" id="libraryNavigationLabel">
            Library sections
          </h2>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close"
          ></button>
        </div>

        <div class="offcanvas-body">
          <nav aria-label="Mobile library sections">
            <ul class="list-unstyled mb-0">
              {
                sections.map((section) => (
                  <li class="mb-2">
                    <a
                      class="btn btn-outline-dark w-100 text-start"
                      href={section.href}
                      data-bs-dismiss="offcanvas"
                    >
                      <span class="text-secondary me-2">{section.number}</span>
                      {section.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>

      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .library-shell {
    min-height: 100vh;
    background: #f5f7fa;
  }

  .library-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 1030;
    display: flex;
    width: 17.5rem;
    flex-direction: column;
    padding: 1.5rem;
    color: #ffffff;
    background: #111827;
  }

  .library-brand,
  .library-mobile-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .library-brand strong {
    display: block;
    font-size: 0.95rem;
  }

  .library-brand small {
    display: block;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.75rem;
  }

  .library-brand-mark {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.65rem;
    color: #111827;
    background: #fbbf24;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .library-nav {
    margin-top: 3rem;
  }

  .library-nav-label {
    margin: 0 0 0.75rem;
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .library-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .library-nav li + li {
    margin-top: 0.3rem;
  }

  .library-nav a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.7rem;
    border-radius: 0.55rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .library-nav a:hover,
  .library-nav a:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.11);
  }

  .library-nav a span {
    width: 1.25rem;
    color: rgba(255, 255, 255, 0.43);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .library-sidebar-footer {
    margin-top: auto;
  }

  .library-sidebar-footer p {
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.43);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .library-content {
    min-height: 100vh;
    margin-left: 17.5rem;
  }

  .library-mobile-header {
    display: none;
  }

  @media (max-width: 991.98px) {
    .library-sidebar {
      display: none;
    }

    .library-content {
      margin-left: 0;
    }

    .library-mobile-header {
      position: sticky;
      top: 0;
      z-index: 1020;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1rem;
      border-bottom: 1px solid #e5e7eb;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(12px);
    }

    .library-mobile-brand {
      color: #111827;
      font-size: 0.9rem;
      font-weight: 800;
    }
  }

  @media (max-width: 575.98px) {
    .library-mobile-header {
      padding-inline: 0.75rem;
    }
  }
</style>
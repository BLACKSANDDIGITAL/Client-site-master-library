---
import site from "../../content/site.json";

const year = new Date().getFullYear();
const serviceAreas = site.serviceAreas.join(", ");
---

<footer class="bg-dark text-white pt-5 pb-4">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-5">
        <h2 class="h4">{site.businessName}</h2>

        <p class="text-white-50 mb-0">
          {site.tagline}
        </p>
      </div>

      <div class="col-6 col-lg-3">
        <h3 class="h6 text-uppercase text-white-50">Navigate</h3>

        <ul class="list-unstyled mb-0">
          <li class="mb-2">
            <a class="link-light text-decoration-none" href="/">Home</a>
          </li>

          <li class="mb-2">
            <a class="link-light text-decoration-none" href="/services">
              Services
            </a>
          </li>

          <li class="mb-2">
            <a class="link-light text-decoration-none" href="/about">
              About
            </a>
          </li>

          <li>
            <a class="link-light text-decoration-none" href="/contact">
              Contact
            </a>
          </li>
        </ul>
      </div>

      <div class="col-6 col-lg-4">
        <h3 class="h6 text-uppercase text-white-50">Contact</h3>

        <p class="mb-2">
          <a
            class="link-light text-decoration-none"
            href={`tel:${site.phoneLink}`}
          >
            {site.phoneDisplay}
          </a>
        </p>

        <p class="mb-2">
          <a
            class="link-light text-decoration-none"
            href={`mailto:${site.email}`}
          >
            {site.email}
          </a>
        </p>

        <p class="text-white-50 mb-2">
          {site.address.street}<br />
          {site.address.city}, {site.address.state} {site.address.zip}
        </p>

        <p class="text-white-50 mb-0">
          Serving {serviceAreas}
        </p>
      </div>
    </div>

    <hr class="border-secondary my-4" />

    <div class="d-flex flex-column flex-md-row justify-content-between gap-2 small text-white-50">
      <span>© {year} {site.businessName}. All rights reserved.</span>

      <a class="link-light text-decoration-none" href="/privacy">
        Privacy Policy
      </a>
    </div>
  </div>
</footer>
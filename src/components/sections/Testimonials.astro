---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
}

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

<section class="section section-muted">
  <div class="container">
    <div class="row justify-content-center text-center mb-5">
      <div class="col-lg-8">
        <p class="text-uppercase text-accent fw-bold small mb-3">
          Client Feedback
        </p>

        <h2 class="display-6">
          Trusted by people in the community.
        </h2>

        <p class="lead text-secondary mb-0">
          Replace these demo testimonials with verified client reviews.
        </p>
      </div>
    </div>

    <div class="row g-4">
      {
        testimonials.map((testimonial) => (
          <div class="col-md-6 col-lg-4">
            <article class="card h-100 p-4">
              <div class="text-warning fs-5 mb-3" aria-label="Five stars">
                ★★★★★
              </div>

              <blockquote class="mb-4">
                <p class="fs-5 mb-0">“{testimonial.quote}”</p>
              </blockquote>

              <footer class="mt-auto">
                <strong class="d-block">{testimonial.name}</strong>
                <span class="text-secondary small">
                  {testimonial.role}
                </span>
              </footer>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>
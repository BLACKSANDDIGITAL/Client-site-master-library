---
import faqItems from "../../content/faq.json";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Answers before you get started",
  description = "Use this section to address the questions clients hear most often."
} = Astro.props;
---

<section class="section section--alt" aria-labelledby="faq-heading">
  <div class="content-container">
    <SectionHeading
      eyebrow="Frequently asked questions"
      title={title}
      description={description}
    />

    <div class="faq-list">
      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: var(--space-3);
  }

  details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  summary {
    padding: 1rem 1.1rem;
    cursor: pointer;
    color: var(--color-text);
    font-weight: 800;
  }

  details p {
    margin: 0;
    padding: 0 1.1rem 1.1rem;
    color: var(--color-muted);
  }

  details[open] {
    border-color: var(--color-primary);
  }
</style>

---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="text-center mb-5">
          <p class="text-uppercase text-accent fw-bold small mb-3">
            Frequently Asked Questions
          </p>

          <h2 class="display-6">
            Answers before you get started.
          </h2>

          <p class="lead text-secondary mb-0">
            Use this section to address the questions clients hear most often.
          </p>
        </div>

        <div class="accordion" id="homepageFaq">
          {
            items.map((item, index) => {
              const headingId = `faq-heading-${index}`;
              const collapseId = `faq-collapse-${index}`;
              const isFirst = index === 0;

              return (
                <div class="accordion-item">
                  <h3 class="accordion-header" id={headingId}>
                    <button
                      class:list={{
                        "accordion-button": true,
                        "collapsed": !isFirst
                      }}
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target={`#${collapseId}`}
                      aria-expanded={isFirst ? "true" : "false"}
                      aria-controls={collapseId}
                    >
                      {item.question}
                    </button>
                  </h3>

                  <div
                    id={collapseId}
                    class:list={{
                      "accordion-collapse": true,
                      "collapse": true,
                      "show": isFirst
                    }}
                    aria-labelledby={headingId}
                    data-bs-parent="#homepageFaq"
                  >
                    <div class="accordion-body text-secondary">
                      {item.answer}
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>
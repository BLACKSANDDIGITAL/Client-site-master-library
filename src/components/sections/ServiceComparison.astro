---
interface Option {
  name: string;
  bestFor: string;
  includes: string;
}

interface Props {
  title?: string;
  description?: string;
  options?: Option[];
}

const {
  title = "Choose the option that fits your needs",
  description = "Use this only when customers genuinely need help comparing distinct client services or packages.",
  options = [
    {
      name: "Option One",
      bestFor: "A simple or focused customer need.",
      includes: "Describe the verified included scope."
    },
    {
      name: "Option Two",
      bestFor: "A larger, more detailed, or ongoing need.",
      includes: "Describe the verified included scope."
    }
  ]
} = Astro.props;
---

<section class="section section--alt">
  <div class="container">
    <div class="heading">
      <h2>{title}</h2>
      <p>{description}</p>
    </div>

    <div class="comparison-grid">
      {options.map((option) => (
        <article>
          <h3>{option.name}</h3>

          <div>
            <strong>Best for</strong>
            <p>{option.bestFor}</p>
          </div>

          <div>
            <strong>Includes</strong>
            <p>{option.includes}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .heading {
    max-width: 700px;
    margin-bottom: var(--space-6);
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .heading p {
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  article {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  article div {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  strong {
    color: var(--color-primary);
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  article p {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (max-width: 700px) {
    .comparison-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

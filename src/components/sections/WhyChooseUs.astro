---
import SectionHeading from "../ui/SectionHeading.astro";

const reasons = [
  {
    title: "Clear communication",
    text: "Visitors know what happens next, what information is needed, and how to get in touch."
  },
  {
    title: "Local and trustworthy",
    text: "Use this area for genuine business credentials, experience, and service-area information."
  },
  {
    title: "Built to convert",
    text: "Every page can include clear calls to call, request an estimate, or submit an inquiry."
  }
];
---

<section class="section section--alt">
  <div class="container">
    <SectionHeading
      eyebrow="Why choose us"
      title="A website structure built for confident decisions"
      description="Replace these demo statements with real, client-approved differentiators."
      align="center"
    />

    <div class="reasons-grid">
      {reasons.map((reason) => (
        <article>
          <h3>{reason.title}</h3>
          <p>{reason.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  article {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  h3 {
    margin-top: 0;
  }

  p {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (max-width: 720px) {
    .reasons-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

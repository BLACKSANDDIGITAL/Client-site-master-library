---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  image?: string;
}

const {
  eyebrow = "Trusted Local Service",
  title,
  description,
  primaryCtaLabel = "Request a Free Estimate",
  primaryCtaHref = "/contact",
  secondaryCtaLabel = "Call Us Today",
  secondaryCtaHref = "tel:+14085550198",
  image = "/images/placeholders/hero.jpg"
} = Astro.props;
---

<section class="section bg-light overflow-hidden">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <p class="text-uppercase text-accent fw-bold small mb-3">
          {eyebrow}
        </p>

        <h1 class="display-4 mb-4">{title}</h1>

        <p class="lead text-secondary mb-4">
          {description}
        </p>

        <div class="d-flex flex-wrap gap-3">
          <a class="btn btn-primary btn-lg" href={primaryCtaHref}>
            {primaryCtaLabel}
          </a>

          <a class="btn btn-outline-dark btn-lg" href={secondaryCtaHref}>
            {secondaryCtaLabel}
          </a>
        </div>
      </div>

      <div class="col-lg-6">
        <img
          class="img-fluid rounded-4 shadow"
          src={image}
          alt=""
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
---
import Button from "../ui/Button.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Plan {
  name: string;
  price: string;
  description: string;
  features: string[];
  featured?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  plans?: Plan[];
}

const {
  title = "Simple package options",
  description = "Display pricing only when the client has approved current, clear, and accurate pricing or package information.",
  plans = [
    {
      name: "Starter",
      price: "Contact for pricing",
      description: "A basic option for a focused need.",
      features: [
        "Approved included item",
        "Approved included item",
        "Approved included item"
      ]
    },
    {
      name: "Most popular",
      price: "Contact for pricing",
      description: "A more complete service option.",
      features: [
        "Approved included item",
        "Approved included item",
        "Approved included item"
      ],
      featured: true
    },
    {
      name: "Custom",
      price: "Request a quote",
      description: "For work that needs a tailored scope.",
      features: [
        "Custom service scope",
        "Client-approved process",
        "Clear next step"
      ]
    }
  ]
} = Astro.props;
---

<section class="section">
  <div class="container">
    <SectionHeading title={title} description={description} align="center" />

    <div class="pricing-grid">
      {plans.map((plan) => (
        <article class:list={["pricing-card", { featured: plan.featured }]}>
          {plan.featured && <p class="popular">Popular option</p>}

          <h3>{plan.name}</h3>
          <p class="price">{plan.price}</p>
          <p class="description">{plan.description}</p>

          <ul>
            {plan.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>

          <Button href="/contact" variant={plan.featured ? "primary" : "outline"}>
            Ask about this option
          </Button>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: var(--space-5);
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .pricing-card.featured {
    border: 2px solid var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .popular {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.3rem;
  }

  .price {
    margin: var(--space-3) 0 0;
    color: var(--color-primary);
    font-size: 1.25rem;
    font-weight: 850;
  }

  .description {
    color: var(--color-muted);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
  }

  .pricing-card :global(.button) {
    width: 100%;
    margin-top: auto;
  }

  @media (max-width: 800px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

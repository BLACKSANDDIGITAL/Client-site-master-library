---
import SectionHeading from "../ui/SectionHeading.astro";

interface ProcessStep {
  number: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  steps?: ProcessStep[];
}

const {
  eyebrow = "How it works",
  title = "A clear path from first contact to completion",
  description = "Replace these demo steps with the client’s real customer process.",
  steps = [
    {
      number: "01",
      title: "Get in touch",
      description: "Call, request an estimate, or use the preferred booking method."
    },
    {
      number: "02",
      title: "Confirm details",
      description: "Review the service need, scope, timing, and next best step."
    },
    {
      number: "03",
      title: "Move forward",
      description: "Complete the work and provide any agreed follow-up."
    }
  ]
} = Astro.props;
---

<section class="section" aria-labelledby="process-heading">
  <div class="container">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
    />

    <ol class="process-steps">
      {steps.map((step) => (
        <li class="process-step">
          <span class="process-step__number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-step {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .process-step__number {
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  h3 {
    margin: var(--space-4) 0 var(--space-2);
    color: var(--color-text);
    font-size: 1.25rem;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .process-steps {
      grid-template-columns: 1fr;
    }
  }
</style>

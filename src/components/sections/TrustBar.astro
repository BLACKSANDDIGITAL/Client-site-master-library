---
interface Item {
  label: string;
  value: string;
}

interface Props {
  items?: Item[];
}

const {
  items = [
    { value: "Licensed", label: "Only if verified" },
    { value: "Insured", label: "Only if verified" },
    { value: "Local", label: "Use accurate service-area information" },
    { value: "Trusted", label: "Support with approved reviews or proof" }
  ]
} = Astro.props;
---

<section class="trust-bar" aria-label="Business trust information">
  <div class="container trust-grid">
    {items.map((item) => (
      <div class="trust-item">
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-bar {
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .trust-item {
    display: grid;
    gap: var(--space-1);
    text-align: center;
  }

  strong {
    color: var(--color-primary);
    font-size: 1rem;
  }

  span {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 720px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

---
interface TrustItem {
  value: string;
  label: string;
}

interface Props {
  items?: TrustItem[];
}

const {
  items = [
    { value: "Verified", label: "Use real business credentials" },
    { value: "Local", label: "Use actual service-area information" },
    { value: "Clear", label: "Explain the customer process" },
    { value: "Responsive", label: "Only if the client confirms it" }
  ]
} = Astro.props;
---

<section class="trust-bar" aria-label="Business trust information">
  <div class="container trust-bar__grid">
    {items.map((item) => (
      <div class="trust-bar__item">
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-bar {
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .trust-bar__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .trust-bar__item {
    display: grid;
    gap: var(--space-1);
    text-align: center;
  }

  strong {
    color: var(--color-primary);
    font-size: 1rem;
  }

  span {
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .trust-bar__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

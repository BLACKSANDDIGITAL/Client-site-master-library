---
import site from "../../content/site.json";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Proudly serving the local area",
  description = "Contact us to confirm service availability for your address."
} = Astro.props;
---

<section class="section section--alt">
  <div class="container service-area-grid">
    <div>
      <SectionHeading
        eyebrow="Service area"
        title={title}
        description={description}
      />
    </div>

    <div class="area-card">
      <h3>Areas served</h3>
      <ul>
        {site.serviceAreas.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .service-area-grid {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    align-items: start;
    gap: var(--space-7);
  }

  .area-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  h3 {
    margin-top: 0;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.15rem;
  }

  @media (max-width: 760px) {
    .service-area-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>

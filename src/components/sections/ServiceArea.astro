---
import site from "../../content/site.json";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";

interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "Proudly serving the local area",
  description = "Contact us to confirm availability for your address or project location.",
  ctaLabel = "Contact us",
  ctaHref = "/contact"
} = Astro.props;
---

<section class="section section--alt">
  <div class="container service-area">
    <div>
      <SectionHeading
        eyebrow="Service areas"
        title={title}
        description={description}
      />

      <Button href={ctaHref} variant="outline">{ctaLabel}</Button>
    </div>

    <aside class="service-area__card" aria-label="Areas served">
      <h3>Areas served</h3>

      <ul>
        {site.serviceAreas.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .service-area {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr);
    align-items: start;
    gap: var(--space-7);
  }

  .service-area__card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  h3 {
    margin-top: 0;
    font-size: 1.2rem;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .service-area {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>

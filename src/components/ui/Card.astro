---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<article class={`card ${className}`}>
  <slot />
</article>

<style>
  .card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
</style>
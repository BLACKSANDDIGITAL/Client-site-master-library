---
import Button from "../ui/Button.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  image?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  eyebrow = "Built around your needs",
  title = "A high-impact hero for a real client image.",
  description = "Use this variation only with an approved, high-quality photo that supports the client’s service, people, work, product, or location.",
  image = "",
  primaryLabel = "Request an estimate",
  primaryHref = "/contact"
} = Astro.props;

const backgroundStyle = image
  ? `background-image: linear-gradient(90deg, rgba(15, 35, 44, 0.88), rgba(15, 35, 44, 0.36)), url(${image});`
  : "";
---

<section class="hero-overlay" style={backgroundStyle}>
  <div class="container hero-overlay__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
    <Button href={primaryHref}>{primaryLabel}</Button>
  </div>
</section>

<style>
  .hero-overlay {
    display: grid;
    min-height: 560px;
    align-items: center;
    background:
      linear-gradient(120deg, rgba(15, 35, 44, 0.92), rgba(15, 76, 92, 0.72)),
      linear-gradient(135deg, #0f4c5c, #0f8174);
    background-position: center;
    background-size: cover;
    color: white;
  }

  .hero-overlay__content {
    max-width: 800px;
    padding-block: var(--space-9);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5.25rem);
    line-height: 1.03;
    letter-spacing: -0.05em;
  }

  p:not(.eyebrow) {
    max-width: 660px;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1.1rem;
  }

  .hero-overlay :global(.button--primary) {
    background: var(--color-accent);
    color: var(--color-text);
  }

  @media (max-width: 700px) {
    .hero-overlay {
      min-height: 470px;
    }
  }
</style>

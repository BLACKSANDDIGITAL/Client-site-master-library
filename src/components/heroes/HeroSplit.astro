---
import Button from "../ui/Button.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow = "Hero option one",
  title = "A reusable split-layout hero section.",
  description = "Use this for service businesses, consultants, agencies, portfolios, and many other client websites.",
  primaryLabel = "Primary Call to Action",
  primaryHref = "/contact",
  secondaryLabel = "Secondary Action",
  secondaryHref = "/services"
} = Astro.props;
---

<section class="split-hero">
  <div class="split-hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p class="description">{description}</p>

    <div class="actions">
      <Button href={primaryHref}>{primaryLabel}</Button>
      <Button href={secondaryHref} variant="outline">{secondaryLabel}</Button>
    </div>
  </div>

  <div class="split-hero-image" role="img" aria-label="Placeholder for a client photo">
    <span>Replace this with a client photo</span>
  </div>
</section>

<style>
  .split-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.9fr);
    gap: var(--space-7);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface-alt);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .description {
    max-width: 620px;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .split-hero-image {
    display: grid;
    min-height: 280px;
    place-items: start;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #0d5c45, #0f8174);
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 760px) {
    .split-hero {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .split-hero-image {
      min-height: 200px;
    }
  }
</style>

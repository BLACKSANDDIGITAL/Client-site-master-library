---
import Button from "../ui/Button.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";

interface Props {
  serviceName: string;
  description: string;
  location?: string;
}

const {
  serviceName,
  description,
  location = ""
} = Astro.props;
---

<section class="service-hero">
  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Services", href: "/services" },
        { label: serviceName }
      ]}
    />

    {location && <p class="eyebrow">Serving {location}</p>}

    <h1>{serviceName}</h1>
    <p>{description}</p>

    <Button href="/contact">Request a Free Estimate</Button>
  </div>
</section>

<style>
  .service-hero {
    padding-block: var(--space-8);
    background: linear-gradient(135deg, var(--color-secondary), var(--color-surface));
  }

  .service-hero > div {
    max-width: 860px;
  }

  :global(.breadcrumbs) {
    margin-bottom: var(--space-5);
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    line-height: 1.04;
    letter-spacing: -0.05em;
  }

  p:not(.eyebrow) {
    max-width: 720px;
    color: var(--color-muted);
    font-size: 1.12rem;
  }
</style>

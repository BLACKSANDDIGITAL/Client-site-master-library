---
import site from "../../content/site.json";
import services from "../../content/services.json";
import Honeypot from "./Honeypot.astro";
import ConsentCheckbox from "./ConsentCheckbox.astro";

interface Props {
  formAction?: string;
  formName?: string;
  showConsent?: boolean;
  showServiceSelect?: boolean;
  title?: string;
}

const {
  formAction = "/thank-you",
  formName = "contact",
  showConsent = false,
  showServiceSelect = true,
  title = "Send us a message"
} = Astro.props;
---

<form
  class="contact-form-component"
  method="POST"
  action={formAction}
  data-form-name={formName}
>
  <input type="hidden" name="static-form-name" value={formName} />
  <Honeypot />

  <h2>{title}</h2>

  <div class="form-row">
    <div class="form-field">
      <label for={`${formName}-name`}>
        Name <span class="required" aria-hidden="true">*</span>
      </label>
      <input
        id={`${formName}-name`}
        name="name"
        type="text"
        autocomplete="name"
        required
      />
    </div>

    <div class="form-field">
      <label for={`${formName}-phone`}>
        Phone <span class="required" aria-hidden="true">*</span>
      </label>
      <input
        id={`${formName}-phone`}
        name="phone"
        type="tel"
        autocomplete="tel"
        required
      />
    </div>
  </div>

  <div class="form-field">
    <label for={`${formName}-email`}>
      Email <span class="required" aria-hidden="true">*</span>
    </label>
    <input
      id={`${formName}-email`}
      name="email"
      type="email"
      autocomplete="email"
      required
    />
  </div>

  {showServiceSelect && services.length > 0 && (
    <div class="form-field">
      <label for={`${formName}-service`}>Service needed</label>
      <select id={`${formName}-service`} name="service">
        <option value="">Select a service</option>
        {services.map((service) => (
          <option value={service.slug}>{service.name}</option>
        ))}
      </select>
    </div>
  )}

  <div class="form-field">
    <label for={`${formName}-message`}>
      How can we help? <span class="required" aria-hidden="true">*</span>
    </label>
    <textarea
      id={`${formName}-message`}
      name="message"
      rows="6"
      required
    ></textarea>
  </div>

  {showConsent && <ConsentCheckbox />}

  <button type="submit">Send request</button>
</form>

<style>
  .contact-form-component {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-alt);
  }

  .contact-form-component h2 {
    margin-top: 0;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .form-field {
    display: grid;
    gap: var(--space-1);
  }

  label {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .required {
    color: var(--color-danger);
  }

  input,
  textarea,
  select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: white;
    font: inherit;
  }

  input:focus,
  textarea:focus,
  select:focus {
    border-color: var(--color-primary);
    outline: 3px solid var(--color-accent);
    outline-offset: 1px;
  }

  button {
    min-height: 48px;
    margin-top: var(--space-2);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: white;
    cursor: pointer;
    font-weight: 700;
    transition: background var(--transition-fast);
  }

  button:hover {
    background: var(--color-primary-dark);
  }

  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
